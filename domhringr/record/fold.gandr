} ;

/// `a_verdicts_judge_grades_its_answers`: the judge grades its verdict; a
/// stranger grades it, the judge grades a verdict never made and the verdict
/// concurrently, too few grades, a read answer refused and an unread one
/// met; the owner dispatches again and the judge grades after it.
@[ checks ]
def gradingCommits() -> -F List(Commit) {
  run opened <- rooted(1, 10, Open(Signed(100, 10)));
  run dispatched <- child(2, 10, 1, Dispatch(1, 20, briefOne));
  run judged <- child(3, 50, 2, Verdict(2, 50, 903, 705, rulings));
  run admitted <- child(4, 50, 3, Graded(3, Cons(Met, Cons(Refused, Nil)), Refused));
  run forged <- child(5, 70, 3, Graded(3, Cons(Met, Cons(Refused, Nil)), Refused));
  run unknown <- child(6, 50, 3, Graded(9999, Cons(Met, Cons(Refused, Nil)), Refused));
  run concurrent <- child(7, 50, 2, Graded(3, Cons(Met, Cons(Refused, Nil)), Refused));
  run short <- child(8, 50, 3, Graded(3, Cons(Met, Nil), Met));
  run readRefused <- child(9, 50, 3, Graded(3, Cons(Refused, Cons(Refused, Nil)), Refused));
  run unreadMet <- child(10, 50, 3, Graded(3, Cons(Met, Cons(Met, Nil)), Met));
  run second <- child(11, 10, 3, Dispatch(1, 20, briefOne));
  run stale <- child(12, 50, 11, Graded(3, Cons(Met, Cons(Refused, Nil)), Refused));
  (Cons(
    opened,
    Cons(
      dispatched,
      Cons(
        judged,
        Cons(
          admitted,
          Cons(
            forged,
            Cons(
              unknown,
              Cons(
                concurrent,
                Cons(short, Cons(readRefused, Cons(unreadMet, Cons(second, Cons(stale, Nil)))))
              )
            )
          )
        )
      )
    )
  ) : List(Commit))
}

/// A grading by a key but the verdict's judge, whose grades do not answer
