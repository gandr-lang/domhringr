// The fold: a tree's commits, in canonical order, folded into its view — the
// owner, the members granted, the notes, the paths bound, the names claimed,
// the labels introduced, the book of presented endpoints, the attested
// indexes, the tree read as a task, and the commits admitted and refused. It
// follows `fold` of `domhringr-record-tree`
// (`crates/record-tree/src/fold.rs`) and the task it reads
// (`crates/record-tree/src/task.rs`), and each exemplar below is one of that
// fold's test sequences, its commits numbered in the canonical order the
// exemplar gives them.
//
// The commits arrive already in canonical order: the topological order and
// the commit-id tie-break are the store's. A commit's authority is read from
// its causal past, the pasts of its parents merged, so a receipt concurrent
// with a grant is not under it whatever its place in the order. The
// operation fences, the proofs and the ids are integers the exemplars state.
//
// Every call is bound by `run` before its value is passed on: a call nested
// in an argument doubles the lowered function with each case around it, and
// three cases deep in the fold one such call lowers past the run's bound
// (gandr #1856). A view is read by matching its whole constructor, no field
// being read by projection (gandr #1106).

// Lists, and the rubric the grades come from.
import "../strategy/rubric.gandr" ;

// Rulings and grades.
import "../strategy/grade.gandr" ;

// The receipt kinds.
import "./receipt.gandr" ;

// The checks and their refusals.
import "./authority.gandr" ;

// The channels' moves and the monitor that replays them.
import "../arena/protocol.gandr" ;

/// A list with `x` after its last element.
@[ checks ]
def rec append(a : Type, xs : List(a), x : a) -> -F List(a) {
  case xs {
    Nil => (Cons(x, Nil) : List(a)),
    Cons(y, rest) => {
      run later <- append[<](a, rest, x);
      (Cons(y, later) : List(a))
    }
  }
}

/// An admitted note and its author.
@[ checks ]
data Noted : Type {
  NotedBy : (author : Integer, text : String) --> Noted;
}

/// A bound path's binding: the path, the author of its last admitted bind,
/// and its target.
@[ checks ]
data Binding : Type {
  BoundBy : (path : Name, author : Integer, target : Target) --> Binding;
}

/// An introduced label's introduction: the label, the author of its last
/// admitted introduction, and the tree it names.
@[ checks ]
data Introduction : Type {
  IntroducedBy : (label : Name, author : Integer, tree : Integer) --> Introduction;
}

/// An author's presence in the book: the endpoint it presented and the commit
/// that presented it.
@[ checks ]
data Presence : Type {
  PresentAt : (author : Integer, endpoint : EndpointAddr, since : Integer) --> Presence;
}

/// An author's claim about an index: the index, the commit carrying it, and
/// the parents it was derived at.
@[ checks ]
data Attestation : Type {
  AttestedBy : (
    author : Integer,
    index : Integer,
    commit : Integer,
    parents : List(Integer)
  ) --> Attestation;
}

/// A refused commit and why.
@[ checks ]
data RefusedCommit : Type {
  RefusedAt : (commit : Integer, refusal : Refusal) --> RefusedCommit;
}

/// A question of a graded verdict, by its hash, and its grade.
@[ checks ]
data Marked : Type {
  MarkedAs : (question : Integer, grade : Grade) --> Marked;
}

/// A receipt the fold admitted into the task, as the task records it.
@[ checks ]
data Step : Type {
  DispatchStep : (edition : Integer, seat : Integer, brief : Brief) --> Step;
  ReportStep : (dispatch : Integer, author : Integer, content : Integer, summary : String) --> Step;
  HandoffStep : (dispatch : Integer, giver : Integer, to : Integer) --> Step;
  RetireStep : (dispatch : Integer, author : Integer) --> Step;
  PauseStep : (dispatch : Integer, author : Integer) --> Step;
  VerdictStep : (
    dispatch : Integer,
    judge : Integer,
    rubric : Integer,
    transcript : Integer,
    answers : List(Ruled)
  ) --> Step;
  VerifiedStep : (
    dispatch : Integer,
    runner : Integer,
    playbook : Integer,
    step : String,
    output : Integer,
    status : Status
  ) --> Step;
  GradedStep : (
    dispatch : Integer,
    verdict : Integer,
    rubric : Integer,
    grades : List(Marked),
    composed : Grade
  ) --> Step;
  DecideStep : (dispatch : Integer, operator : Integer, decision : Decision) --> Step;
  LandedStep : (dispatch : Integer, decided : Integer, operator : Integer, merge : String) --> Step;
}

/// An admitted step and its commit.
@[ checks ]
data Stepped : Type {
  StepAt : (commit : Integer, step : Step) --> Stepped;
}

/// Who an attempt's slot is with: its holder, or the holder who retired from
/// it and the retirement's commit.
@[ checks ]
data Slot : Type {
  Held : (seat : Integer) --> Slot;
  Vacated : (by : Integer, retirement : Integer) --> Slot;
}

/// Whether an attempt is reported on: awaited, or by this report, the last
/// in canonical order.
@[ checks ]
data Answer : Type {
  Awaited : Answer;
  ReportedBy : (report : Integer) --> Answer;
}

/// How far an attempt has gone past its report: the furthest of its
/// verifications, gradings, decisions and landings, ranked in that order.
@[ checks ]
data Progress : Type {
  Unchecked : Progress;
  VerifiedBy : (verification : Integer) --> Progress;
  GradedBy : (grading : Integer, composed : Grade) --> Progress;
  DecidedBy : (decide : Integer, decision : Decision) --> Progress;
  LandedBy : (landing : Integer, merge : String) --> Progress;
}

/// Where a task stands: no dispatch admitted, or the current attempt — the
/// admitted dispatch last in canonical order, its edition and brief, its
/// slot, its answer and its progress.
@[ checks ]
data Current : Type {
  Undispatched : Current;
  Attempt : (
    dispatch : Integer,
    edition : Integer,
    brief : Brief,
    slot : Slot,
    answer : Answer,
    progress : Progress
  ) --> Current;
}

/// A tree read as a task: the admitted steps in canonical order, and where
/// it stands.
@[ checks ]
data Task : Type {
  Task : (steps : List(Stepped), current : Current) --> Task;
}

/// What a peer makes of a tree. Members, admitted commits and claims are
/// held in key order; bindings, introductions, the book and the indexes in
/// the order of their keys; notes, attestations and refusals in canonical
/// order.
@[ checks ]
data View : Type {
  View : (
    owner : Integer,
    members : List(Integer),
    notes : List(Noted),
    bindings : List(Binding),
    claims : List(Name),
    introductions : List(Introduction),
    book : List(Presence),
    attestations : List(Attestation),
    indexes : List(Attestation),
    task : Task,
    admitted : List(Integer),
    refused : List(RefusedCommit)
  ) --> View;
}

/// The fold's answer: no commit is the tree's Open, or the view.
@[ checks ]
data Folded : Type {
  Unopened : Folded;
  Folded : (view : View) --> Folded;
}

/// A placed commit's causal past, as its children read it.
@[ checks ]
data Carried : Type {
  CarriedBy : (commit : Integer, past : Past) --> Carried;
}

/// An admitted commit's operation fence.
@[ checks ]
data Fenced : Type {
  FencedBy : (operation : Integer, commit : Integer) --> Fenced;
}

/// A dispatch's slot play: the edition it names and where its play stands.
@[ checks ]
data SlotPlay : Type {
  SlotOf : (dispatch : Integer, edition : Integer, phase : Phase) --> SlotPlay;
}

/// An admitted verdict's judge channel: its judge, its dispatch, its rubric,
/// its rulings and where its play stands.
@[ checks ]
data JudgePlay : Type {
  JudgeOf : (
    verdict : Integer,
    judge : Integer,
    dispatch : Integer,
    rubric : Integer,
    rulings : List(Ruled),
    phase : Phase
  ) --> JudgePlay;
}

/// A dispatch's decision channel and where its play stands.
@[ checks ]
data DecisionPlay : Type {
  DecisionOf : (dispatch : Integer, phase : Phase) --> DecisionPlay;
}

/// An admitted decision: its commit, its dispatch and its operator.
@[ checks ]
data Decided : Type {
  DecisionBy : (decision : Integer, dispatch : Integer, operator : Integer) --> Decided;
}

/// What the fold remembers between commits: how many it placed, the pasts
/// the placed commits carry, the admitted fences, and the plays of the
/// slots, the judges and the decisions, with the admitted decisions.
@[ checks ]
data Ledger : Type {
  Ledger : (
    placed : Integer,
    pasts : List(Carried),
    fences : List(Fenced),
    slots : List(SlotPlay),
    judges : List(JudgePlay),
    choices : List(DecisionPlay),
    decided : List(Decided)
  ) --> Ledger;
}

/// The carried past of a placed commit, if it was placed. The past is
/// returned in its carrier: a type argument reads `Past` as its constructor
/// (gandr #1855).
@[ checks ]
def rec pastOf(commit : Integer, pasts : List(Carried)) -> -F Maybe(Carried) {
  case pasts {
    Nil => (None : Maybe(Carried)),
    Cons(carried, rest) => case carried {
      CarriedBy(held, past) => case held == commit {
        true => (Some(carried) : Maybe(Carried)),
        false => become pastOf[<](commit, rest)
      }
    }
  }
}

/// A commit's causal past read from its parents: their pasts merged, a
/// parent not placed contributing nothing.
@[ checks ]
def rec inherit(parents : List(Integer), pasts : List(Carried)) -> -F Past {
  case parents {
    Nil => emptyPast,
    Cons(parent, rest) => {
      run others <- inherit[<](rest, pasts);
      case pastOf(parent, pasts) {
        None => others,
        Some(carried) => case carried {
          CarriedBy(held, past) => become merge(past, others)
        }
      }
    }
  }
}

/// The admitted commit carrying an operation, if any.
@[ checks ]
def rec fenced(operation : Integer, fences : List(Fenced)) -> -F Maybe(Integer) {
  case fences {
    Nil => (None : Maybe(Integer)),
    Cons(fence, rest) => case fence {
      FencedBy(held, commit) => case held == operation {
        true => (Some(commit) : Maybe(Integer)),
        false => become fenced[<](operation, rest)
      }
    }
  }
}

/// A dispatch's slot play, if it was dispatched.
@[ checks ]
def rec slotOf(dispatch : Integer, slots : List(SlotPlay)) -> -F Maybe(SlotPlay) {
  case slots {
    Nil => (None : Maybe(SlotPlay)),
    Cons(play, rest) => case play {
      SlotOf(held, edition, phase) => case held == dispatch {
        true => (Some(play) : Maybe(SlotPlay)),
        false => become slotOf[<](dispatch, rest)
      }
    }
  }
}

/// The slot plays with a dispatch's play set to `phase` under `edition`.
@[ checks ]
def rec setSlot(
  dispatch : Integer,
  edition : Integer,
  phase : Phase,
  slots : List(SlotPlay)
) -> -F List(SlotPlay) {
  case slots {
    Nil => (Cons(SlotOf(dispatch, edition, phase), Nil) : List(SlotPlay)),
    Cons(play, rest) => case play {
      SlotOf(held, was, before) => case held == dispatch {
        true => (Cons(SlotOf(dispatch, edition, phase), rest) : List(SlotPlay)),
        false => {
          run later <- setSlot[<](dispatch, edition, phase, rest);
          (Cons(play, later) : List(SlotPlay))
        }
      }
    }
  }
}

/// An admitted verdict's judge channel, if it is in `verdicts`, the
/// verdicts of a commit's causal past.
@[ checks ]
def rec judgeOf(
  verdict : Integer,
  verdicts : List(Integer),
  judges : List(JudgePlay)
) -> -F Maybe(JudgePlay) {
  case member(verdict, verdicts) {
    false => (None : Maybe(JudgePlay)),
    true => case judges {
      Nil => (None : Maybe(JudgePlay)),
      Cons(play, rest) => case play {
        JudgeOf(held, judge, dispatch, rubric, rulings, phase) => case held == verdict {
          true => (Some(play) : Maybe(JudgePlay)),
          false => become judgeOf[<](verdict, verdicts, rest)
        }
      }
    }
  }
}

/// The judge channels with a verdict's play moved to `phase`.
@[ checks ]
def rec setJudge(verdict : Integer, phase : Phase, judges : List(JudgePlay)) -> -F List(JudgePlay) {
  case judges {
    Nil => (Nil : List(JudgePlay)),
    Cons(play, rest) => case play {
      JudgeOf(held, judge, dispatch, rubric, rulings, before) => case held == verdict {
        true => (Cons(
          JudgeOf(held, judge, dispatch, rubric, rulings, phase),
          rest
        ) : List(JudgePlay)),
        false => {
          run later <- setJudge[<](verdict, phase, rest);
          (Cons(play, later) : List(JudgePlay))
        }
      }
    }
  }
}

/// Where a dispatch's decision channel stands: fresh until a move on it is
/// admitted.
@[ checks ]
def rec choiceOf(dispatch : Integer, choices : List(DecisionPlay)) -> -F Phase {
  case choices {
    Nil => DecisionFresh,
    Cons(play, rest) => case play {
      DecisionOf(held, phase) => case held == dispatch {
        true => phase,
        false => become choiceOf[<](dispatch, rest)
      }
    }
  }
}

/// The decision channels with a dispatch's play set to `phase`.
@[ checks ]
def rec setChoice(
  dispatch : Integer,
  phase : Phase,
  choices : List(DecisionPlay)
) -> -F List(DecisionPlay) {
  case choices {
    Nil => (Cons(DecisionOf(dispatch, phase), Nil) : List(DecisionPlay)),
    Cons(play, rest) => case play {
      DecisionOf(held, before) => case held == dispatch {
        true => (Cons(DecisionOf(dispatch, phase), rest) : List(DecisionPlay)),
        false => {
          run later <- setChoice[<](dispatch, phase, rest);
          (Cons(play, later) : List(DecisionPlay))
        }
      }
    }
  }
}

/// An admitted decision, if it is in `decisions`, the decisions of a
/// commit's causal past.
@[ checks ]
def rec decisionOf(
  decision : Integer,
  decisions : List(Integer),
  decided : List(Decided)
) -> -F Maybe(Decided) {
  case member(decision, decisions) {
    false => (None : Maybe(Decided)),
    true => case decided {
      Nil => (None : Maybe(Decided)),
      Cons(record, rest) => case record {
        DecisionBy(held, dispatch, operator) => case held == decision {
          true => (Some(record) : Maybe(Decided)),
          false => become decisionOf[<](decision, decisions, rest)
        }
      }
    }
  }
}

/// A move's progress on a channel of a dispatch: where the play moves to, or
/// the refusal that stops it.
@[ checks ]
data Advance : Type {
  Went : (phase : Phase) --> Advance;
  Halted : (refusal : Refusal) --> Advance;
}

/// A move on a channel at `phase`, related to `dispatch`: refused as not
/// current unless `dispatch` is the course's and was dispatched, then
/// replayed under its edition.
@[ checks ]
def advance(
  course : Course,
  slots : List(SlotPlay),
  dispatch : Integer,
  phase : Phase,
  move : Move
) -> -F Advance {
  case current(course, dispatch) {
    Fail(refusal) => Halted(refusal),
    Pass => case slotOf(dispatch, slots) {
      None => Halted(NotCurrent),
      Some(play) => case play {
        SlotOf(held, edition, slotPhase) => case monitor(edition, phase, move) {
          Moved(next) => Went(next),
          Stuck(reason) => Halted(Protocol(edition, move, reason))
        }
      }
    }
  }
}

/// A grading or a landing with no predecessor in its causal past, replayed
/// on an empty channel of the course's dispatch.
@[ checks ]
def unstarted(course : Course, slots : List(SlotPlay), phase : Phase, move : Move) -> -F Refusal {
  case course {
    Idle => NotCurrent,
    Dispatched(
      placed,
      dispatch,
      moved,
      holder
    ) => case advance(course, slots, dispatch, phase, move) {
      Went(next) => NotCurrent,
      Halted(refusal) => refusal
    }
  }
}

/// A move on a dispatch's slot by an author whose authority is `authority`:
/// refused as not current when the dispatch has no slot play; otherwise
/// replayed, a protocol refusal standing before the authority's, and the
/// authority's before the move is admitted.
@[ checks ]
def slotMove(
  slots : List(SlotPlay),
  dispatch : Integer,
  authority : Outcome,
  move : Move
) -> -F Advance {
  case slotOf(dispatch, slots) {
    None => Halted(NotCurrent),
    Some(play) => case play {
      SlotOf(held, edition, phase) => case monitor(edition, phase, move) {
        Stuck(reason) => Halted(Protocol(edition, move, reason)),
        Moved(next) => case authority {
          Pass => Went(next),
          Fail(refusal) => Halted(refusal)
        }
      }
    }
  }
}

/// What an admitted receipt changes in the view beside admitting its commit.
@[ checks ]
data Change : Type {
  Quiet : Change;
  Joins : (to : Integer) --> Change;
  Notes : (text : String) --> Change;
  Attests : (index : Integer) --> Change;
  Binds : (path : Name, target : Target) --> Change;
  Claims : (domain : Name) --> Change;
  Introduces : (label : Name, tree : Integer) --> Change;
  Presents : (endpoint : EndpointAddr) --> Change;
  Withdraws : (holder : Integer) --> Change;
  Steps : (step : Step) --> Change;
}

/// The fold's judgement of one receipt: refused, the ledger as the refusal
/// leaves it; or admitted, with the past it hands its children, the ledger
/// and its change to the view.
@[ checks ]
data Admission : Type {
  Refuse : (refusal : Refusal, ledger : Ledger) --> Admission;
  Admit : (past : Past, ledger : Ledger, change : Change) --> Admission;
}

/// The ledger with its slot plays replaced.
@[ checks ]
def withSlots(ledger : Ledger, slots : List(SlotPlay)) -> -F Ledger {
  case ledger {
    Ledger(placed, pasts, fences, was, judges, choices, decided) => Ledger(
      placed,
      pasts,
      fences,
      slots,
      judges,
      choices,
      decided
    )
  }
}

/// The ledger with its judge channels replaced.
@[ checks ]
def withJudges(ledger : Ledger, judges : List(JudgePlay)) -> -F Ledger {
  case ledger {
    Ledger(placed, pasts, fences, slots, was, choices, decided) => Ledger(
      placed,
      pasts,
      fences,
      slots,
      judges,
      choices,
      decided
    )
  }
}

/// The ledger with its decision channels and admitted decisions replaced.
@[ checks ]
def withChoices(
  ledger : Ledger,
  choices : List(DecisionPlay),
  decided : List(Decided)
) -> -F Ledger {
  case ledger {
    Ledger(placed, pasts, fences, slots, judges, was, before) => Ledger(
      placed,
      pasts,
      fences,
      slots,
      judges,
      choices,
      decided
    )
  }
}

/// The past with a peer granted.
@[ checks ]
def granting(past : Past, peer : Integer) -> -F Past {
  case past {
    Past(grantees, seats, verdicts, decisions, course) => {
      run more <- insert(peer, grantees);
      Past(more, seats, verdicts, decisions, course)
    }
  }
}

/// The past with a peer seated and the course moved on.
@[ checks ]
def seating(past : Past, seat : Integer, course : Course) -> -F Past {
  case past {
    Past(grantees, seats, verdicts, decisions, was) => {
      run more <- insert(seat, seats);
      Past(grantees, more, verdicts, decisions, course)
    }
  }
}

/// The past with its course moved on.
@[ checks ]
def coursing(past : Past, course : Course) -> -F Past {
  case past {
    Past(grantees, seats, verdicts, decisions, was) => Past(
      grantees,
      seats,
      verdicts,
      decisions,
      course
    )
  }
}

/// The past with a verdict admitted.
@[ checks ]
def ruling(past : Past, verdict : Integer) -> -F Past {
  case past {
    Past(grantees, seats, verdicts, decisions, course) => {
      run more <- insert(verdict, verdicts);
      Past(grantees, seats, more, decisions, course)
    }
  }
}

/// The past with a decision admitted.
@[ checks ]
def deciding(past : Past, decision : Integer) -> -F Past {
  case past {
    Past(grantees, seats, verdicts, decisions, course) => {
      run more <- insert(decision, decisions);
      Past(grantees, seats, verdicts, more, course)
    }
  }
}

/// Whether a proof is the statement of `key` naming `peer`.
@[ checks ]
def verifies(proof : Proof, key : Integer, peer : Integer) -> -F Bool {
  case proof {
    Signed(by, names) => case by == key {
      true => names == peer,
      false => by == key
    }
  }
}

/// The choice a decision makes on its channel.
@[ checks ]
def choice(decision : Decision) -> -F Choice {
  case decision {
    Land => ToLand,
    Rework(reason) => ToRework,
    Abandon => ToAbandon
  }
}

/// Each question of a verdict's rulings with its grade, in order.
@[ checks ]
def rec marks(rulings : List(Ruled), grades : List(Grade)) -> -F List(Marked) {
  case rulings {
    Nil => (Nil : List(Marked)),
    Cons(ruled, rest) => case grades {
      Nil => (Nil : List(Marked)),
      Cons(grade, more) => case ruled {
        OnQuestion(question, ruling) => {
          run later <- marks[<](rest, more);
          (Cons(MarkedAs(question, grade), later) : List(Marked))
        }
      }
    }
  }
}

/// A move on the current dispatch's slot by its holder: a report, a
/// handoff, a retirement or a pause, admitted with `past` handed on and
/// `change` to the view once the slot play takes it.
@[ checks ]
def heldMove(
  ledger : Ledger,
  course : Course,
  author : Integer,
  dispatch : Integer,
  move : Move,
  past : Past,
  change : Change
) -> -F Admission {
  case ledger {
    Ledger(placed, pasts, fences, slots, judges, choices, decided) => {
      run authority <- answerable(course, dispatch, author);
      case slotMove(slots, dispatch, authority, move) {
        Halted(refusal) => Refuse(refusal, ledger),
        Went(phase) => case slotOf(dispatch, slots) {
          None => Refuse(NotCurrent, ledger),
          Some(play) => case play {
            SlotOf(held, edition, before) => {
              run moved <- setSlot(dispatch, edition, phase, slots);
              run next <- withSlots(ledger, moved);
              Admit(past, next, change)
            }
          }
        }
      }
    }
  }
}

/// A verdict on `dispatch`, admitted from the judge it names while its
/// dispatch is current.
@[ checks ]
def verdictMove(
  ledger : Ledger,
  past : Past,
  author : Integer,
  commit : Integer,
  dispatch : Integer,
  judge : Integer,
  rubric : Integer,
  transcript : Integer,
  answers : List(Ruled)
) -> -F Admission {
  case author == judge {
    false => Refuse(NotJudge, ledger),
    true => case past {
      Past(grantees, seats, verdicts, decisions, course) => case ledger {
        Ledger(placed, pasts, fences, slots, judges, choices, decided) => case advance(
          course,
          slots,
          dispatch,
          JudgeFresh,
          VerdictMove
        ) {
          Halted(refusal) => Refuse(refusal, ledger),
          Went(phase) => {
            run more <- append(
              JudgePlay,
              judges,
              JudgeOf(commit, judge, dispatch, rubric, answers, phase)
            );
            run next <- withJudges(ledger, more);
            run handed <- ruling(past, commit);
            Admit(handed, next, Steps(VerdictStep(dispatch, judge, rubric, transcript, answers)))
          }
        }
      }
    }
  }
}

/// A verification on `dispatch`, admitted from the runner it names while its
/// dispatch is current.
@[ checks ]
def verifiedMove(
  ledger : Ledger,
  past : Past,
  author : Integer,
  runner : Integer,
  dispatch : Integer,
  step : Step
) -> -F Admission {
  case author == runner {
    false => Refuse(NotRunner, ledger),
    true => case past {
      Past(grantees, seats, verdicts, decisions, course) => case ledger {
        Ledger(placed, pasts, fences, slots, judges, choices, decided) => case advance(
          course,
          slots,
          dispatch,
          RunnerOpen,
          VerifiedMove
        ) {
          Halted(refusal) => Refuse(refusal, ledger),
          Went(phase) => Admit(past, ledger, Steps(step))
        }
      }
    }
  }
}

/// A grading of `verdict`, admitted when the verdict is in its causal past,
/// from that verdict's judge, answering its rulings and composing its
/// grades, while the verdict's dispatch is current.
@[ checks ]
def gradedMove(
  ledger : Ledger,
  past : Past,
  author : Integer,
  verdict : Integer,
  grades : List(Grade),
  composed : Grade
) -> -F Admission {
  case past {
    Past(grantees, seats, verdicts, decisions, course) => case ledger {
      Ledger(placed, pasts, fences, slots, judges, choices, decided) => case judgeOf(
        verdict,
        verdicts,
        judges
      ) {
        None => {
          run refusal <- unstarted(course, slots, JudgeFresh, GradedMove);
          Refuse(refusal, ledger)
        },
        Some(play) => case play {
          JudgeOf(held, judge, dispatch, rubric, rulings, phase) => case grading(
            judge,
            rulings,
            author,
            grades,
            composed
          ) {
            Fail(refusal) => Refuse(refusal, ledger),
            Pass => case advance(course, slots, dispatch, phase, GradedMove) {
              Halted(refusal) => Refuse(refusal, ledger),
              Went(next) => {
                run moved <- setJudge(verdict, next, judges);
                run kept <- withJudges(ledger, moved);
                run marked <- marks(rulings, grades);
                Admit(past, kept, Steps(GradedStep(dispatch, verdict, rubric, marked, composed)))
              }
            }
          }
        }
      }
    }
  }
}

/// A decision on `dispatch`, admitted from the operator it names, holding
/// the operator role, while the dispatch is current.
@[ checks ]
def decideMove(
  ledger : Ledger,
  past : Past,
  authorized : Bool,
  author : Integer,
  commit : Integer,
  dispatch : Integer,
  operator : Integer,
  decision : Decision
) -> -F Admission {
  case authorized {
    false => Refuse(NoAuthority, ledger),
    true => case author == operator {
      false => Refuse(NotOperator, ledger),
      true => case past {
        Past(grantees, seats, verdicts, decisions, course) => case ledger {
          Ledger(placed, pasts, fences, slots, judges, choices, decided) => {
            run phase <- choiceOf(dispatch, choices);
            run chosen <- choice(decision);
            case advance(course, slots, dispatch, phase, DecideMove(chosen)) {
              Halted(refusal) => Refuse(refusal, ledger),
              Went(next) => {
                run moved <- setChoice(dispatch, next, choices);
                run made <- append(Decided, decided, DecisionBy(commit, dispatch, operator));
                run kept <- withChoices(ledger, moved, made);
                run handed <- deciding(past, commit);
                Admit(handed, kept, Steps(DecideStep(dispatch, operator, decision)))
              }
            }
          }
        }
      }
    }
  }
}

/// A landing of `decision`, admitted when a decision to land is in its
/// causal past, from that decision's operator, while its dispatch is
/// current.
@[ checks ]
def landedMove(
  ledger : Ledger,
  past : Past,
  author : Integer,
  decision : Integer,
  merge : String
) -> -F Admission {
  case past {
    Past(grantees, seats, verdicts, decisions, course) => case ledger {
      Ledger(placed, pasts, fences, slots, judges, choices, decided) => case decisionOf(
        decision,
        decisions,
        decided
      ) {
        None => {
          run refusal <- unstarted(course, slots, DecisionFresh, LandedMove);
          Refuse(refusal, ledger)
        },
        Some(record) => case record {
          DecisionBy(held, dispatch, operator) => case landing(operator, author) {
            Fail(refusal) => Refuse(refusal, ledger),
            Pass => {
              run phase <- choiceOf(dispatch, choices);
              case advance(course, slots, dispatch, phase, LandedMove) {
                Halted(refusal) => Refuse(refusal, ledger),
                Went(next) => {
                  run moved <- setChoice(dispatch, next, choices);
                  run kept <- withChoices(ledger, moved, decided);
                  Admit(past, kept, Steps(LandedStep(dispatch, decision, author, merge)))
                }
              }
            }
          }
        }
      }
    }
  }
}

/// A dispatch by an author with authority: replayed as the first move of its
/// slot play, the play kept even when its edition is unknown, then admitted
/// as the course's dispatch with its seat seated.
@[ checks ]
def dispatchMove(
  ledger : Ledger,
  past : Past,
  commit : Integer,
  placed : Integer,
  edition : Integer,
  seat : Integer,
  brief : Brief
) -> -F Admission {
  case ledger {
    Ledger(count, pasts, fences, slots, judges, choices, decided) => case monitor(
      edition,
      SlotFresh,
      DispatchMove
    ) {
      Stuck(reason) => {
        run kept <- setSlot(commit, edition, SlotFresh, slots);
        run next <- withSlots(ledger, kept);
        Refuse(Protocol(edition, DispatchMove, reason), next)
      },
      Moved(phase) => {
        run kept <- setSlot(commit, edition, phase, slots);
        run next <- withSlots(ledger, kept);
        run handed <- seating(past, seat, Dispatched(placed, commit, placed, SeatHolds(seat)));
        Admit(handed, next, Steps(DispatchStep(edition, seat, brief)))
      }
    }
  }
}

/// A receipt's admission by its kind, its tree and fence already checked:
/// `authorized` when the author is the owner or granted in the causal past,
/// `present` when also when a dispatch or handoff there seated it.
@[ checks ]
def admitKind(
  owner : Integer,
  open : Integer,
  bad : List(Integer),
  ledger : Ledger,
  past : Past,
  authorized : Bool,
  present : Bool,
  author : Integer,
  commit : Integer,
  kind : Kind
) -> -F Admission {
  case ledger {
    Ledger(placed, pasts, fences, slots, judges, choices, decided) => case past {
      Past(grantees, seats, verdicts, decisions, course) => case kind {
        Open(proof) => case member(commit, bad) {
          true => Refuse(BadProof, ledger),
          false => case commit == open {
            true => Admit(past, ledger, Quiet),
            false => Refuse(SecondOpen, ledger)
          }
        },
        Grant(to) => case authorized {
          true => {
            run handed <- granting(past, to);
            Admit(handed, ledger, Joins(to))
          },
          false => Refuse(NoAuthority, ledger)
        },
        Note(text) => case authorized {
          true => Admit(past, ledger, Notes(text)),
          false => Refuse(NoAuthority, ledger)
        },
        Indexed(index) => case authorized {
          true => Admit(past, ledger, Attests(index)),
          false => Refuse(NoAuthority, ledger)
        },
        Bind(path, target) => case authorized {
          true => Admit(past, ledger, Binds(path, target)),
          false => Refuse(NoAuthority, ledger)
        },
        Claim(domain) => case author == owner {
          true => Admit(past, ledger, Claims(domain)),
          false => Refuse(NotOwner, ledger)
        },
        Introduce(tree, label) => case authorized {
          true => Admit(past, ledger, Introduces(label, tree)),
          false => Refuse(NoAuthority, ledger)
        },
        Present(endpoint, proof) => case present {
          true => case endpoint {
            EndpointAt(key, port) => case verifies(proof, key, author) {
              true => Admit(past, ledger, Presents(endpoint)),
              false => Refuse(ForeignEndpoint, ledger)
            }
          },
          false => Refuse(NoAuthority, ledger)
        },
        Withdraw(holder) => case author == owner {
          true => Admit(past, ledger, Withdraws(holder)),
          false => case present {
            true => case holder == author {
              true => Admit(past, ledger, Withdraws(holder)),
              false => Refuse(ForeignPresence, ledger)
            },
            false => Refuse(NoAuthority, ledger)
          }
        },
        Dispatch(edition, seat, brief) => case authorized {
          true => become dispatchMove(ledger, past, commit, placed, edition, seat, brief),
          false => Refuse(NoAuthority, ledger)
        },
        Report(dispatch, content, summary) => become heldMove(
          ledger,
          course,
          author,
          dispatch,
          ReportMove,
          past,
          Steps(ReportStep(dispatch, author, content, summary))
        ),
        Handoff(dispatch, to) => {
          run passed <- moved(course, placed, SeatHolds(to));
          run handed <- seating(past, to, passed);
          become heldMove(
            ledger,
            course,
            author,
            dispatch,
            HandoffMove,
            handed,
            Steps(HandoffStep(dispatch, author, to))
          )
        },
        Retire(dispatch) => {
          run vacated <- moved(course, placed, Vacant);
          run handed <- coursing(past, vacated);
          become heldMove(
            ledger,
            course,
            author,
            dispatch,
            RetireMove,
            handed,
            Steps(RetireStep(dispatch, author))
          )
        },
        Pause(dispatch) => become heldMove(
          ledger,
          course,
          author,
          dispatch,
          PauseMove,
          past,
          Steps(PauseStep(dispatch, author))
        ),
        Verdict(dispatch, judge, rubric, transcript, answers) => become verdictMove(
          ledger,
          past,
          author,
          commit,
          dispatch,
          judge,
          rubric,
          transcript,
          answers
        ),
        Verified(dispatch, runner, playbook, step, output, status) => become verifiedMove(
          ledger,
          past,
          author,
          runner,
          dispatch,
          VerifiedStep(dispatch, runner, playbook, step, output, status)
        ),
        Graded(
          verdict,
          grades,
          composed
        ) => become gradedMove(ledger, past, author, verdict, grades, composed),
        Decide(dispatch, operator, decision) => become decideMove(
          ledger,
          past,
          authorized,
          author,
          commit,
          dispatch,
          operator,
          decision
        ),
        Landed(decision, merge) => become landedMove(ledger, past, author, decision, merge)
      }
    }
  }
}

/// Whether an author holds write authority: the owner, or granted in its
/// causal past.
@[ checks ]
def authorizes(owner : Integer, author : Integer, grantees : List(Integer)) -> -F Bool {
  case author == owner {
    true => author == owner,
    false => become member(author, grantees)
  }
}

/// Whether an author may present or withdraw: with write authority, or
/// seated by a dispatch or handoff in its causal past.
@[ checks ]
def presents(authorized : Bool, author : Integer, seats : List(Integer)) -> -F Bool {
  case authorized {
    true => authorized,
    false => become member(author, seats)
  }
}

/// A receipt's admission: refused when it names another tree, or carries the
/// fence of a commit admitted earlier; otherwise judged by its kind.
@[ checks ]
def admission(
  tree : Integer,
  owner : Integer,
  open : Integer,
  bad : List(Integer),
  ledger : Ledger,
  past : Past,
  author : Integer,
  commit : Integer,
  receipt : Receipt
) -> -F Admission {
  case receipt {
    Receipt(named, operation, kind) => case named == tree {
      false => Refuse(WrongTree(named), ledger),
      true => case ledger {
        Ledger(placed, pasts, fences, slots, judges, choices, decided) => case fenced(
          operation,
          fences
        ) {
          Some(first) => Refuse(Duplicate(first), ledger),
          None => case past {
            Past(grantees, seats, verdicts, decisions, course) => {
              run authorized <- authorizes(owner, author, grantees);
              run present <- presents(authorized, author, seats);
              become admitKind(
                owner,
                open,
                bad,
                ledger,
                past,
                authorized,
                present,
                author,
                commit,
                kind
              )
            }
          }
        }
      }
    }
  }
}

/// The key a path, a name or a label is compared by.
@[ checks ]
def keyOf(name : Name) -> -F Integer {
  case name {
    Named(key, text) => key
  }
}

/// The bindings with a path's binding set, in path order.
@[ checks ]
def rec rebind(binding : Binding, bindings : List(Binding)) -> -F List(Binding) {
  case binding {
    BoundBy(path, author, target) => case bindings {
      Nil => (Cons(binding, Nil) : List(Binding)),
      Cons(held, rest) => case held {
        BoundBy(heldPath, heldAuthor, heldTarget) => {
          run key <- keyOf(path);
          run heldKey <- keyOf(heldPath);
          case key < heldKey {
            true => (Cons(binding, bindings) : List(Binding)),
            false => case key == heldKey {
              true => (Cons(binding, rest) : List(Binding)),
              false => {
                run later <- rebind[<](binding, rest);
                (Cons(held, later) : List(Binding))
              }
            }
          }
        }
      }
    }
  }
}

/// The claims with a domain added, in name order.
@[ checks ]
def rec claim(domain : Name, claims : List(Name)) -> -F List(Name) {
  case claims {
    Nil => (Cons(domain, Nil) : List(Name)),
    Cons(held, rest) => {
      run key <- keyOf(domain);
      run heldKey <- keyOf(held);
      case key < heldKey {
        true => (Cons(domain, claims) : List(Name)),
        false => case key == heldKey {
          true => claims,
          false => {
            run later <- claim[<](domain, rest);
            (Cons(held, later) : List(Name))
          }
        }
      }
    }
  }
}

/// The introductions with a label's introduction set, in label order.
@[ checks ]
def rec reintroduce(
  introduction : Introduction,
  introductions : List(Introduction)
) -> -F List(Introduction) {
  case introduction {
    IntroducedBy(label, author, tree) => case introductions {
      Nil => (Cons(introduction, Nil) : List(Introduction)),
      Cons(held, rest) => case held {
        IntroducedBy(heldLabel, heldAuthor, heldTree) => {
          run key <- keyOf(label);
          run heldKey <- keyOf(heldLabel);
          case key < heldKey {
            true => (Cons(introduction, introductions) : List(Introduction)),
            false => case key == heldKey {
              true => (Cons(introduction, rest) : List(Introduction)),
              false => {
                run later <- reintroduce[<](introduction, rest);
                (Cons(held, later) : List(Introduction))
              }
            }
          }
        }
      }
    }
  }
}

/// The book with an author's presence set, in author order.
@[ checks ]
def rec enter(presence : Presence, book : List(Presence)) -> -F List(Presence) {
  case presence {
    PresentAt(author, endpoint, since) => case book {
      Nil => (Cons(presence, Nil) : List(Presence)),
      Cons(held, rest) => case held {
        PresentAt(heldAuthor, heldEndpoint, heldSince) => case author < heldAuthor {
          true => (Cons(presence, book) : List(Presence)),
          false => case author == heldAuthor {
            true => (Cons(presence, rest) : List(Presence)),
            false => {
              run later <- enter[<](presence, rest);
              (Cons(held, later) : List(Presence))
            }
          }
        }
      }
    }
  }
}

/// The book with an author's presence withdrawn, present or not.
@[ checks ]
def rec leave(holder : Integer, book : List(Presence)) -> -F List(Presence) {
  case book {
    Nil => book,
    Cons(held, rest) => case held {
      PresentAt(author, endpoint, since) => case author == holder {
        true => rest,
        false => {
          run later <- leave[<](holder, rest);
          (Cons(held, later) : List(Presence))
        }
      }
    }
  }
}

/// The indexes with an author's attestation set, in author order.
@[ checks ]
def rec attest(attestation : Attestation, indexes : List(Attestation)) -> -F List(Attestation) {
  case attestation {
    AttestedBy(author, index, commit, parents) => case indexes {
      Nil => (Cons(attestation, Nil) : List(Attestation)),
      Cons(held, rest) => case held {
        AttestedBy(heldAuthor, heldIndex, heldCommit, heldParents) => case author < heldAuthor {
          true => (Cons(attestation, indexes) : List(Attestation)),
          false => case author == heldAuthor {
            true => (Cons(attestation, rest) : List(Attestation)),
            false => {
              run later <- attest[<](attestation, rest);
              (Cons(held, later) : List(Attestation))
            }
          }
        }
      }
    }
  }
}

/// Where a progress ranks: unchecked, then verified, graded, decided and
/// landed.
@[ checks ]
def rank(progress : Progress) -> -F Integer {
  case progress {
    Unchecked => 0,
    VerifiedBy(verification) => 1,
    GradedBy(grading, composed) => 2,
    DecidedBy(decide, decision) => 3,
    LandedBy(landing, merge) => 4
  }
}

/// An attempt's progress advanced to `next` unless it has gone further: a
/// later step of one rank replaces an earlier, a lower rank never undoes a
/// higher.
@[ checks ]
def further(held : Progress, next : Progress) -> -F Progress {
  run heldRank <- rank(held);
  run nextRank <- rank(next);
  case nextRank >= heldRank {
    true => next,
    false => held
  }
}

/// The current attempt with its answer reported by `report`, when the
/// report answers its dispatch.
@[ checks ]
def reported(current : Current, answered : Integer, report : Integer) -> -F Current {
  case current {
    Undispatched => current,
    Attempt(dispatch, edition, brief, slot, answer, progress) => case answered == dispatch {
      true => Attempt(dispatch, edition, brief, slot, ReportedBy(report), progress),
      false => current
    }
  }
}

/// The current attempt with its slot moved to `slot`, when the move answers
/// its dispatch.
@[ checks ]
def reslotted(current : Current, answered : Integer, moved : Slot) -> -F Current {
  case current {
    Undispatched => current,
    Attempt(dispatch, edition, brief, slot, answer, progress) => case answered == dispatch {
      true => Attempt(dispatch, edition, brief, moved, answer, progress),
      false => current
    }
  }
}

/// The current attempt with its progress advanced to `next`, when the check
/// answers its dispatch.
@[ checks ]
def progressed(current : Current, answered : Integer, next : Progress) -> -F Current {
  case current {
    Undispatched => current,
    Attempt(dispatch, edition, brief, slot, answer, progress) => case answered == dispatch {
      true => {
        run moved <- further(progress, next);
        Attempt(dispatch, edition, brief, slot, answer, moved)
      },
      false => current
    }
  }
}

/// Where the task stands once an admitted step is recorded: a dispatch
/// starts a fresh attempt; a step answering the current attempt's dispatch
/// moves its slot, its answer or its progress; a verdict, a pause and a step
/// answering an earlier dispatch move nothing.
@[ checks ]
def standing(current : Current, commit : Integer, step : Step) -> -F Current {
  case step {
    DispatchStep(
      edition,
      seat,
      brief
    ) => Attempt(commit, edition, brief, Held(seat), Awaited, Unchecked),
    ReportStep(answered, author, content, summary) => become reported(current, answered, commit),
    HandoffStep(answered, giver, to) => become reslotted(current, answered, Held(to)),
    RetireStep(answered, author) => become reslotted(current, answered, Vacated(author, commit)),
    PauseStep(answered, author) => current,
    VerdictStep(answered, judge, rubric, transcript, answers) => current,
    VerifiedStep(answered, runner, playbook, name, output, status) => become progressed(
      current,
      answered,
      VerifiedBy(commit)
    ),
    GradedStep(answered, verdict, rubric, grades, composed) => become progressed(
      current,
      answered,
      GradedBy(commit, composed)
    ),
    DecideStep(answered, operator, decision) => become progressed(
      current,
      answered,
      DecidedBy(commit, decision)
    ),
    LandedStep(answered, decided, operator, merge) => become progressed(
      current,
      answered,
      LandedBy(commit, merge)
    )
  }
}

/// The task with an admitted step recorded.
@[ checks ]
def record(task : Task, commit : Integer, step : Step) -> -F Task {
  case task {
    Task(steps, current) => {
      run more <- append(Stepped, steps, StepAt(commit, step));
      run now <- standing(current, commit, step);
      Task(more, now)
    }
  }
}

/// The view with an admitted commit's change made and the commit admitted.
@[ checks ]
def apply(
  view : View,
  commit : Integer,
  author : Integer,
  parents : List(Integer),
  change : Change
) -> -F View {
  case view {
    View(
      owner,
      members,
      notes,
      bindings,
      claims,
      introductions,
      book,
      attestations,
      indexes,
      task,
      admitted,
      refused
    ) => {
      run taken <- insert(commit, admitted);
      case change {
        Quiet => View(
          owner,
          members,
          notes,
          bindings,
          claims,
          introductions,
          book,
          attestations,
          indexes,
          task,
          taken,
          refused
        ),
        Joins(to) => {
          run more <- insert(to, members);
          View(
            owner,
            more,
            notes,
            bindings,
            claims,
            introductions,
            book,
            attestations,
            indexes,
            task,
            taken,
            refused
          )
        },
        Notes(text) => {
          run more <- append(Noted, notes, NotedBy(author, text));
          View(
            owner,
            members,
            more,
            bindings,
            claims,
            introductions,
            book,
            attestations,
            indexes,
            task,
            taken,
            refused
          )
        },
        Attests(index) => {
          run more <- append(Attestation, attestations, AttestedBy(author, index, commit, parents));
          run latest <- attest(AttestedBy(author, index, commit, parents), indexes);
          View(
            owner,
            members,
            notes,
            bindings,
            claims,
            introductions,
            book,
            more,
            latest,
            task,
            taken,
            refused
          )
        },
        Binds(path, target) => {
          run more <- rebind(BoundBy(path, author, target), bindings);
          View(
            owner,
            members,
            notes,
            more,
            claims,
            introductions,
            book,
            attestations,
            indexes,
            task,
            taken,
            refused
          )
        },
        Claims(domain) => {
          run more <- claim(domain, claims);
          View(
            owner,
            members,
            notes,
            bindings,
            more,
            introductions,
            book,
            attestations,
            indexes,
            task,
            taken,
            refused
          )
        },
        Introduces(label, tree) => {
          run more <- reintroduce(IntroducedBy(label, author, tree), introductions);
          View(
            owner,
            members,
            notes,
            bindings,
            claims,
            more,
            book,
            attestations,
            indexes,
            task,
            taken,
            refused
          )
        },
        Presents(endpoint) => {
          run more <- enter(PresentAt(author, endpoint, commit), book);
          View(
            owner,
            members,
            notes,
            bindings,
            claims,
            introductions,
            more,
            attestations,
            indexes,
            task,
            taken,
            refused
          )
        },
        Withdraws(holder) => {
          run fewer <- leave(holder, book);
          View(
            owner,
            members,
            notes,
            bindings,
            claims,
            introductions,
            fewer,
            attestations,
            indexes,
            task,
            taken,
            refused
          )
        },
        Steps(step) => {
          run recorded <- record(task, commit, step);
          View(
            owner,
            members,
            notes,
            bindings,
            claims,
            introductions,
            book,
            attestations,
            indexes,
            recorded,
            taken,
            refused
          )
        }
      }
    }
  }
}

/// The view with a commit refused for `refusal`, after the refusals before
/// it.
@[ checks ]
def refuse(view : View, commit : Integer, refusal : Refusal) -> -F View {
  case view {
    View(
      owner,
      members,
      notes,
      bindings,
      claims,
      introductions,
      book,
      attestations,
      indexes,
      task,
      admitted,
      refused
    ) => {
      run more <- append(RefusedCommit, refused, RefusedAt(commit, refusal));
      View(
        owner,
        members,
        notes,
        bindings,
        claims,
        introductions,
        book,
        attestations,
        indexes,
        task,
        admitted,
        more
      )
    }
  }
}

/// The fold between two commits: the ledger and the view so far.
@[ checks ]
data Folding : Type {
  Folding : (ledger : Ledger, view : View) --> Folding;
}

/// The ledger once a commit is placed: one more placed, its past carried,
/// and its fence held when it was admitted.
@[ checks ]
def placing(ledger : Ledger, commit : Integer, past : Past, fence : Maybe(Integer)) -> -F Ledger {
  case ledger {
    Ledger(placed, pasts, fences, slots, judges, choices, decided) => {
      run carried <- append(Carried, pasts, CarriedBy(commit, past));
      run count <- placed + 1;
      case fence {
        None => Ledger(count, carried, fences, slots, judges, choices, decided),
        Some(operation) => {
          run held <- append(Fenced, fences, FencedBy(operation, commit));
          Ledger(count, carried, held, slots, judges, choices, decided)
        }
      }
    }
  }
}

/// One commit placed: its receipt admitted or refused against its causal
/// past, the past it hands its children carried.
@[ checks ]
def place(
  tree : Integer,
  owner : Integer,
  open : Integer,
  bad : List(Integer),
  folding : Folding,
  commit : Commit
) -> -F Folding {
  case folding {
    Folding(ledger, view) => case commit {
      Committed(id, author, parents, blob) => case ledger {
        Ledger(placed, pasts, fences, slots, judges, choices, decided) => {
          run past <- inherit(parents, pasts);
          case blob {
            Garbled => {
              run next <- placing(ledger, id, past, (None : Maybe(Integer)));
              run seen <- refuse(view, id, Undecodable);
              Folding(next, seen)
            },
            Decoded(receipt) => case receipt {
              Receipt(
                named,
                operation,
                kind
              ) => case admission(tree, owner, open, bad, ledger, past, author, id, receipt) {
                Refuse(refusal, kept) => {
                  run next <- placing(kept, id, past, (None : Maybe(Integer)));
                  run seen <- refuse(view, id, refusal);
                  Folding(next, seen)
                },
                Admit(handed, kept, change) => {
                  run next <- placing(kept, id, handed, (Some(operation) : Maybe(Integer)));
                  run seen <- apply(view, id, author, parents, change);
                  Folding(next, seen)
                }
              }
            }
          }
        }
      }
    }
  }
}

/// The commits placed in order.
@[ checks ]
def rec walk(
  tree : Integer,
  owner : Integer,
  open : Integer,
  bad : List(Integer),
  folding : Folding,
  commits : List(Commit)
) -> -F Folding {
  case commits {
    Nil => folding,
    Cons(commit, rest) => {
      run next <- place(tree, owner, open, bad, folding, commit);
      become walk[<](tree, owner, open, bad, next, rest)
    }
  }
}

/// The tree's Open: its commit and its author, the owner.
@[ checks ]
data Opening : Type {
  OpenedBy : (commit : Integer, owner : Integer) --> Opening;
}

/// Whether a commit is an Open of `tree`, and its proof the tree key's
/// naming its author.
@[ checks ]
def opens(tree : Integer, commit : Commit) -> -F Bool {
  case commit {
    Committed(id, author, parents, blob) => case blob {
      Garbled => id < id,
      Decoded(receipt) => case receipt {
        Receipt(named, operation, kind) => case kind {
          Open(proof) => case named == tree {
            true => become verifies(proof, tree, author),
            false => named == tree
          },
          _ => id < id
        }
      }
    }
  }
}

/// The tree's Open: of the commits with no parents that open the tree, the
/// first in canonical order.
@[ checks ]
def rec openOf(tree : Integer, commits : List(Commit)) -> -F Maybe(Opening) {
  case commits {
    Nil => (None : Maybe(Opening)),
    Cons(commit, rest) => case commit {
      Committed(id, author, parents, blob) => case parents {
        Cons(parent, more) => become openOf[<](tree, rest),
        Nil => case opens(tree, commit) {
          true => (Some(OpenedBy(id, author)) : Maybe(Opening)),
          false => become openOf[<](tree, rest)
        }
      }
    }
  }
}

/// The commits that are Opens of `tree` whose proof is not the tree key's
/// naming their author.
@[ checks ]
def rec forged(tree : Integer, commits : List(Commit)) -> -F List(Integer) {
  case commits {
    Nil => (Nil : List(Integer)),
    Cons(commit, rest) => {
      run later <- forged[<](tree, rest);
      case commit {
        Committed(id, author, parents, blob) => case blob {
          Garbled => later,
          Decoded(receipt) => case receipt {
            Receipt(named, operation, kind) => case kind {
              Open(proof) => case named == tree {
                true => case verifies(proof, tree, author) {
                  true => later,
                  false => become insert(id, later)
                },
                false => later
              },
              _ => later
            }
          }
        }
      }
    }
  }
}

/// The fold before its first commit: nothing placed, and the view of the
/// owner alone.
@[ checks ]
def start(owner : Integer) -> -F Folding {
  Folding(
    Ledger(0, Nil, Nil, Nil, Nil, Nil, Nil),
    View(owner, Nil, Nil, Nil, Nil, Nil, Nil, Nil, Nil, Task(Nil, Undispatched), Nil, Nil)
  )
}

/// Fold `tree`'s commits, given in canonical order, into its view; no view
/// when no commit is the tree's Open.
@[ checks ]
def fold(tree : Integer, commits : List(Commit)) -> -F Folded {
  case openOf(tree, commits) {
    None => Unopened,
    Some(opening) => case opening {
      OpenedBy(open, owner) => {
        run bad <- forged(tree, commits);
        run first <- start(owner);
        run folded <- walk(tree, owner, open, bad, first, commits);
        case folded {
          Folding(last, seen) => Folded(seen)
        }
      }
    }
  }
}

/// The owner of a folded view.
@[ checks ]
def ownerOf(folded : Folded) -> -F Maybe(Integer) {
  case folded {
    Unopened => (None : Maybe(Integer)),
    Folded(view) => case view {
      View(
        owner,
        members,
        notes,
        bindings,
        claims,
        introductions,
        book,
        attestations,
        indexes,
        task,
        admitted,
        refused
      ) => (Some(owner) : Maybe(Integer))
    }
  }
}

/// The notes of a folded view, in canonical order.
@[ checks ]
def notesOf(folded : Folded) -> -F Maybe(List(Noted)) {
  case folded {
    Unopened => (None : Maybe(List(Noted))),
    Folded(view) => case view {
      View(
        owner,
        members,
        notes,
        bindings,
        claims,
        introductions,
        book,
        attestations,
        indexes,
        task,
        admitted,
        refused
      ) => (Some(notes) : Maybe(List(Noted)))
    }
  }
}

