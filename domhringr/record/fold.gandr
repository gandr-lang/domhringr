// The exemplars fold the sequences of the Rust fold's tests, each named for
// its test. Every one is on the tree `100`; the peers are `10` the owner,
// `20` the other peer, and `50`, `70`, `80` and `90` the keys made from the
// bytes 5, 7, 8 and 9; the endpoint keys `500` and `600` are made from 5 and
// 6, and the trees `200`, `260` and `270` are the other trees named. Commits
// are numbered in the canonical order the exemplar gives them, and a
// commit's fence is its own number unless it states one. A content hash or
// a digest is a number in the 700s or 900s, one per text the test hashes.

/// A commit of a receipt on the tree `100` with no parent.
@[ checks ]
def rooted(id : Integer, author : Integer, kind : Kind) -> -F Commit {
  Committed(id, author, Nil, Decoded(Receipt(100, id, kind)))
}

/// A commit of a receipt on the tree `100` with one parent.
@[ checks ]
def child(id : Integer, author : Integer, parent : Integer, kind : Kind) -> -F Commit {
  Committed(id, author, Cons(parent, Nil), Decoded(Receipt(100, id, kind)))
}

/// A commit of a receipt on the tree `100` with two parents.
@[ checks ]
def merged(
  id : Integer,
  author : Integer,
  left : Integer,
  right : Integer,
  kind : Kind
) -> -F Commit {
  Committed(id, author, Cons(left, Cons(right, Nil)), Decoded(Receipt(100, id, kind)))
}

/// A commit of a receipt on the tree `100` with one parent, carrying the
/// fence `operation`.
@[ checks ]
def fencedChild(
  id : Integer,
  author : Integer,
  parent : Integer,
  operation : Integer,
  kind : Kind
) -> -F Commit {
  Committed(id, author, Cons(parent, Nil), Decoded(Receipt(100, operation, kind)))
}

/// The brief the tests dispatch: the path `briefs/one` in the tree.
@[ checks ]
def briefOne = (BriefAt("domhringr://100/briefs/one") : Brief);

/// The rulings the tests' verdicts carry: the question hashed from `read`
/// read as `B`, and the one hashed from `unread` left unread for want of a
/// letter.
@[ checks ]
def rulings = (
  Cons(
    OnQuestion(901, Read(Cons(250000, Cons(750000, Nil)), 0)),
    Cons(OnQuestion(902, Unread(NoLetter)), Nil)
  ) : List(Ruled)
);

/// The revision the tests' landings land at.
@[ checks ]
def revision = ("0123456789abcdef0123456789abcdef01234567" : String);

/// `a_note_by_a_peer_granted_in_its_causal_past_is_admitted`: a grant, a
/// note under it, and a note concurrent with it.
@[ checks ]
def grantedCommits() -> -F List(Commit) {
  run opened <- rooted(1, 10, Open(Signed(100, 10)));
  run granted <- child(2, 10, 1, Grant(20));
  run after <- child(3, 20, 2, Note("after"));
  run beside <- child(4, 20, 1, Note("beside"));
  (Cons(opened, Cons(granted, Cons(after, Cons(beside, Nil)))) : List(Commit))
}

/// The note descending from the grant is admitted.
@[ runs("Some(Cons(NotedBy(20, \"after\"), Nil))") ]
def grantedNotes : () => Maybe(List(Noted)) ;
def grantedNotes = thunk {
  run commits <- grantedCommits();
  run folded <- fold(100, commits);
  become notesOf(folded)
} ;

/// A note concurrent with the grant is not under it.
@[ runs("Some(Cons(RefusedAt(4, NoAuthority), Nil))") ]
def grantedRefused : () => Maybe(List(RefusedCommit)) ;
def grantedRefused = thunk {
  run commits <- grantedCommits();
  run folded <- fold(100, commits);
  become refusedOf(folded)
} ;

/// `the_later_bind_in_canonical_order_wins`: `x` bound and rebound in
/// descent, `y` bound twice concurrently. The paths are `x` = 1 and
/// `y` = 2.
@[ checks ]
def rebindCommits() -> -F List(Commit) {
  run opened <- rooted(1, 10, Open(Signed(100, 10)));
  run first <- child(2, 10, 1, Bind(Named(1, "x"), ToAnchor("domhringr://100/.commit/1")));
  run second <- child(3, 10, 2, Bind(Named(1, "x"), ToDatum("rebound")));
  run left <- child(4, 10, 1, Bind(Named(2, "y"), ToDatum("left")));
  run right <- child(5, 10, 1, Bind(Named(2, "y"), ToDatum("right")));
  (Cons(opened, Cons(first, Cons(second, Cons(left, Cons(right, Nil))))) : List(Commit))
}

/// The rebind descending from the bind wins, and of two concurrent binds the
/// one placed later.
@[ runs("Some(Cons(BoundBy(Named(1, \"x\"), 10, ToDatum(\"rebound\")), Cons(BoundBy(Named(2, \"y\"), 10, ToDatum(\"right\")), Nil)))") ]
def rebound : () => Maybe(List(Binding)) ;
def rebound = thunk {
  run commits <- rebindCommits();
  run folded <- fold(100, commits);
  become bindingsOf(folded)
} ;

/// `a_bind_by_a_non_member_is_refused`: the owner binds `x`, a non-member
/// binds it again.
@[ checks ]
def squatCommits() -> -F List(Commit) {
  run opened <- rooted(1, 10, Open(Signed(100, 10)));
  run bound <- child(2, 10, 1, Bind(Named(1, "x"), ToAnchor("domhringr://100/.commit/1")));
  run squat <- child(3, 20, 2, Bind(Named(1, "x"), ToDatum("squat")));
  (Cons(opened, Cons(bound, Cons(squat, Nil))) : List(Commit))
}

/// The non-member's bind is refused for want of authority.
@[ runs("Some(Cons(RefusedAt(3, NoAuthority), Nil))") ]
def squatRefused : () => Maybe(List(RefusedCommit)) ;
def squatRefused = thunk {
  run commits <- squatCommits();
  run folded <- fold(100, commits);
  become refusedOf(folded)
} ;

/// The path stays as the owner bound it, and nothing else is bound.
@[ runs("Some(Cons(BoundBy(Named(1, \"x\"), 10, ToAnchor(\"domhringr://100/.commit/1\")), Nil))") ]
def squatBindings : () => Maybe(List(Binding)) ;
def squatBindings = thunk {
  run commits <- squatCommits();
  run folded <- fold(100, commits);
  become bindingsOf(folded)
} ;

/// `a_claim_by_anyone_but_the_owner_is_refused`: a member and a stranger
/// claim names beside the owner. The names are `example.test` = 1,
/// `member.test` = 2 and `stranger.test` = 3.
@[ checks ]
def claimCommits() -> -F List(Commit) {
  run opened <- rooted(1, 10, Open(Signed(100, 10)));
  run granted <- child(2, 10, 1, Grant(20));
  run noted <- child(3, 20, 2, Note("member"));
  run byMember <- child(4, 20, 3, Claim(Named(2, "member.test")));
  run byStranger <- child(5, 50, 3, Claim(Named(3, "stranger.test")));
  run byOwner <- child(6, 10, 3, Claim(Named(1, "example.test")));
  (Cons(
    opened,
    Cons(granted, Cons(noted, Cons(byMember, Cons(byStranger, Cons(byOwner, Nil)))))
  ) : List(Commit))
}

/// The owner's claim alone is admitted.
@[ runs("Some(Cons(Named(1, \"example.test\"), Nil))") ]
def claimed : () => Maybe(List(Name)) ;
def claimed = thunk {
  run commits <- claimCommits();
  run folded <- fold(100, commits);
  become claimsOf(folded)
} ;

/// A claim by a member or by a stranger is refused as not the owner's.
@[ runs("Some(Cons(RefusedAt(4, NotOwner), Cons(RefusedAt(5, NotOwner), Nil)))") ]
def claimRefused : () => Maybe(List(RefusedCommit)) ;
def claimRefused = thunk {
  run commits <- claimCommits();
  run folded <- fold(100, commits);
  become refusedOf(folded)
} ;

/// The member holds write authority.
@[ runs("Some(Cons(NotedBy(20, \"member\"), Nil))") ]
def claimNotes : () => Maybe(List(Noted)) ;
def claimNotes = thunk {
  run commits <- claimCommits();
  run folded <- fold(100, commits);
  become notesOf(folded)
} ;

/// `the_later_introduction_of_a_label_rebinds_it`: the owner introduces `b`
/// twice, a member introduces `my friend`, and a stranger `b`. The labels
/// are `b` = 1 and `my friend` = 2.
@[ checks ]
def introductionCommits() -> -F List(Commit) {
  run opened <- rooted(1, 10, Open(Signed(100, 10)));
  run introduced <- child(2, 10, 1, Introduce(200, Named(1, "b")));
  run reintroduced <- child(3, 10, 2, Introduce(260, Named(1, "b")));
  run granted <- child(4, 10, 3, Grant(20));
  run byMember <- child(5, 20, 4, Introduce(270, Named(2, "my friend")));
  run byStranger <- child(6, 50, 5, Introduce(270, Named(1, "b")));
  (Cons(
    opened,
    Cons(introduced, Cons(reintroduced, Cons(granted, Cons(byMember, Cons(byStranger, Nil)))))
  ) : List(Commit))
}

/// The later introduction of `b` rebinds it, and a member introduces under
/// its grant.
@[ runs("Some(Cons(IntroducedBy(Named(1, \"b\"), 10, 260), Cons(IntroducedBy(Named(2, \"my friend\"), 20, 270), Nil)))") ]
def introduced : () => Maybe(List(Introduction)) ;
def introduced = thunk {
  run commits <- introductionCommits();
  run folded <- fold(100, commits);
  become introductionsOf(folded)
} ;

/// A stranger's introduction is refused for want of authority.
@[ runs("Some(Cons(RefusedAt(6, NoAuthority), Nil))") ]
def introductionRefused : () => Maybe(List(RefusedCommit)) ;
def introductionRefused = thunk {
  run commits <- introductionCommits();
  run folded <- fold(100, commits);
  become refusedOf(folded)
} ;

/// `a_presence_naming_another_members_endpoint_is_refused`: the owner
/// presents its endpoint; a member presents it under the owner's proof, then
/// under a proof its own endpoint key made for itself.
@[ checks ]
def foreignCommits() -> -F List(Commit) {
  run opened <- rooted(1, 10, Open(Signed(100, 10)));
  run granted <- child(2, 10, 1, Grant(20));
  run presented <- child(3, 10, 2, Present(EndpointAt(500, 5), Signed(500, 10)));
  run stolen <- child(4, 20, 3, Present(EndpointAt(500, 7), Signed(500, 10)));
  run misproved <- child(5, 20, 4, Present(EndpointAt(500, 8), Signed(600, 20)));
  (Cons(opened, Cons(granted, Cons(presented, Cons(stolen, Cons(misproved, Nil))))) : List(Commit))
}

/// Both of the member's presences are refused by name.
@[ runs("Some(Cons(RefusedAt(4, ForeignEndpoint), Cons(RefusedAt(5, ForeignEndpoint), Nil)))") ]
def foreignRefused : () => Maybe(List(RefusedCommit)) ;
def foreignRefused = thunk {
  run commits <- foreignCommits();
  run folded <- fold(100, commits);
  become refusedOf(folded)
} ;

/// The owner's own presence stands, and the member holds none.
@[ runs("Some(Cons(PresentAt(10, EndpointAt(500, 5), 3), Nil))") ]
def foreignBook : () => Maybe(List(Presence)) ;
def foreignBook = thunk {
  run commits <- foreignCommits();
  run folded <- fold(100, commits);
  become bookOf(folded)
} ;

/// `a_member_cannot_withdraw_the_owners_presence`: the owner presents; a
/// member and a stranger withdraw it, and the member withdraws its own.
@[ checks ]
def withdrawCommits() -> -F List(Commit) {
  run opened <- rooted(1, 10, Open(Signed(100, 10)));
  run granted <- child(2, 10, 1, Grant(20));
  run presented <- child(3, 10, 2, Present(EndpointAt(500, 5), Signed(500, 10)));
  run byMember <- child(4, 20, 3, Withdraw(10));
  run byStranger <- child(5, 50, 3, Withdraw(10));
  run own <- child(6, 20, 3, Withdraw(20));
  (Cons(
    opened,
    Cons(granted, Cons(presented, Cons(byMember, Cons(byStranger, Cons(own, Nil)))))
  ) : List(Commit))
}

/// A member's withdrawal of the owner's presence is refused by name, a
/// stranger's for want of authority.
@[ runs("Some(Cons(RefusedAt(4, ForeignPresence), Cons(RefusedAt(5, NoAuthority), Nil)))") ]
def withdrawRefused : () => Maybe(List(RefusedCommit)) ;
def withdrawRefused = thunk {
  run commits <- withdrawCommits();
  run folded <- fold(100, commits);
  become refusedOf(folded)
} ;

/// A member withdraws its own presence, absent or not.
@[ runs("Some(Cons(1, Cons(2, Cons(3, Cons(6, Nil)))))") ]
def withdrawAdmitted : () => Maybe(List(Integer)) ;
def withdrawAdmitted = thunk {
  run commits <- withdrawCommits();
  run folded <- fold(100, commits);
  become admittedOf(folded)
} ;

/// The owner's presence stands.
@[ runs("Some(Cons(PresentAt(10, EndpointAt(500, 5), 3), Nil))") ]
def withdrawBook : () => Maybe(List(Presence)) ;
def withdrawBook = thunk {
  run commits <- withdrawCommits();
  run folded <- fold(100, commits);
  become bookOf(folded)
} ;

/// `the_book_after_a_withdrawal_does_not_offer_the_endpoint`: the owner and
/// a member present, and the owner withdraws its own presence.
@[ checks ]
def withdrawnCommits() -> -F List(Commit) {
  run opened <- rooted(1, 10, Open(Signed(100, 10)));
  run granted <- child(2, 10, 1, Grant(20));
  run presented <- child(3, 10, 2, Present(EndpointAt(500, 5), Signed(500, 10)));
  run member <- child(4, 20, 3, Present(EndpointAt(600, 6), Signed(600, 20)));
  run withdrawn <- child(5, 10, 4, Withdraw(10));
  (Cons(opened, Cons(granted, Cons(presented, Cons(member, Cons(withdrawn, Nil))))) : List(Commit))
}

/// The withdrawn presence is absent and the other stands.
@[ runs("Some(Cons(PresentAt(20, EndpointAt(600, 6), 4), Nil))") ]
def withdrawnBook : () => Maybe(List(Presence)) ;
def withdrawnBook = thunk {
  run commits <- withdrawnCommits();
  run folded <- fold(100, commits);
  become bookOf(folded)
} ;

/// A presence after the withdrawal is offered again, at its own commit.
@[ runs("Some(Cons(PresentAt(10, EndpointAt(500, 7), 6), Cons(PresentAt(20, EndpointAt(600, 6), 4), Nil)))") ]
def returnedBook : () => Maybe(List(Presence)) ;
def returnedBook = thunk {
  run commits <- withdrawnCommits();
  run back <- child(6, 10, 5, Present(EndpointAt(500, 7), Signed(500, 10)));
  run all <- append(Commit, commits, back);
  run folded <- fold(100, all);
  become bookOf(folded)
} ;

/// `an_attestation_is_admitted_from_the_owner_or_a_member`: the owner
/// attests twice and a member once; a seat and a stranger attest. The index
/// digests are the bytes the test fills them with.
@[ checks ]
def attestationCommits() -> -F List(Commit) {
  run opened <- rooted(1, 10, Open(Signed(100, 10)));
  run granted <- child(2, 10, 1, Grant(20));
  run dispatched <- child(3, 10, 2, Dispatch(1, 80, briefOne));
  run first <- child(4, 10, 3, Indexed(1));
  run second <- child(5, 10, 4, Indexed(2));
  run theirs <- child(6, 20, 5, Indexed(3));
  run seated <- child(7, 80, 6, Indexed(4));
  run alien <- child(8, 90, 6, Indexed(5));
  (Cons(
    opened,
    Cons(
      granted,
      Cons(dispatched, Cons(first, Cons(second, Cons(theirs, Cons(seated, Cons(alien, Nil))))))
    )
  ) : List(Commit))
}

/// Each author's last attestation, at the parents it was derived at.
@[ runs("Some(Cons(AttestedBy(10, 2, 5, Cons(4, Nil)), Cons(AttestedBy(20, 3, 6, Cons(5, Nil)), Nil)))") ]
def attestedIndexes : () => Maybe(List(Attestation)) ;
def attestedIndexes = thunk {
  run commits <- attestationCommits();
  run folded <- fold(100, commits);
  become indexesOf(folded)
} ;

/// Every admitted attestation is retained, in canonical order.
@[ runs("Some(Cons(AttestedBy(10, 1, 4, Cons(3, Nil)), Cons(AttestedBy(10, 2, 5, Cons(4, Nil)), Cons(AttestedBy(20, 3, 6, Cons(5, Nil)), Nil))))") ]
def attested : () => Maybe(List(Attestation)) ;
def attested = thunk {
  run commits <- attestationCommits();
  run folded <- fold(100, commits);
  become attestationsOf(folded)
} ;

/// A seat's and a stranger's attestations are refused for want of
/// authority.
@[ runs("Some(Cons(RefusedAt(7, NoAuthority), Cons(RefusedAt(8, NoAuthority), Nil)))") ]
def attestationRefused : () => Maybe(List(RefusedCommit)) ;
def attestationRefused = thunk {
  run commits <- attestationCommits();
  run folded <- fold(100, commits);
  become refusedOf(folded)
} ;

/// `the_dispatched_seat_reports_on_its_dispatch`: a stranger dispatches
/// itself; the owner dispatches the other peer, a stranger reports on it,
/// and the seat presents and reports. The contents are `mine` = 702 and
/// `done` = 701.
@[ checks ]
def seatCommits() -> -F List(Commit) {
  run opened <- rooted(1, 10, Open(Signed(100, 10)));
  run stray <- child(2, 50, 1, Dispatch(1, 50, briefOne));
  run dispatched <- child(3, 10, 1, Dispatch(1, 20, briefOne));
  run byStranger <- child(4, 50, 3, Report(3, 702, "mine"));
  run presented <- child(5, 20, 3, Present(EndpointAt(600, 9), Signed(600, 20)));
  run reported <- child(6, 20, 5, Report(3, 701, "done"));
  (Cons(
    opened,
    Cons(stray, Cons(dispatched, Cons(byStranger, Cons(presented, Cons(reported, Nil)))))
  ) : List(Commit))
}

/// A dispatch by a non-member is refused for want of authority, and a report
/// by a key not dispatched as not the holder.
