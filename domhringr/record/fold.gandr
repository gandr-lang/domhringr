@[ runs("Some(Cons(RefusedAt(5, NotJudge), Cons(RefusedAt(6, Protocol(1, GradedMove, WrongPayloadIdentity)), Cons(RefusedAt(7, Protocol(1, GradedMove, WrongPayloadIdentity)), Cons(RefusedAt(8, Misgraded), Cons(RefusedAt(9, Misgraded), Cons(RefusedAt(10, Misgraded), Cons(RefusedAt(12, NotCurrent), Nil))))))))") ]
