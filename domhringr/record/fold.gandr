@[ runs("Some(Cons(RefusedAt(4, NotRunner), Cons(RefusedAt(5, NotRunner), Cons(RefusedAt(6, Protocol(1, RetireMove, WrongLabel)), Cons(RefusedAt(9, NotCurrent), Nil)))))") ]
