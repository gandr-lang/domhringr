def supersededCurrent : () => Maybe(Current) ;
def supersededCurrent = thunk {
  run commits <- supersededCommits();
  run folded <- fold(100, commits);
  become currentOf(folded)
} ;

/// `dispatch_editions_govern_each_attempt`: a report before any dispatch,
/// then an attempt under each of editions 1, 2 and 99, each paused before
/// its report and retired after it.
@[ checks ]
def editionCommits() -> -F List(Commit) {
  run opened <- rooted(1, 10, Open(Signed(100, 10)));
  run early <- child(2, 20, 1, Report(7777, 703, "early"));
  run one <- child(3, 10, 2, Dispatch(1, 20, briefOne));
  run pausedOne <- child(4, 20, 3, Pause(3));
  run reportedOne <- child(5, 20, 4, Report(3, 701, "done"));
  run retiredOne <- child(6, 20, 5, Retire(3));
  run two <- child(7, 10, 6, Dispatch(2, 20, briefOne));
  run pausedTwo <- child(8, 20, 7, Pause(7));
  run reportedTwo <- child(9, 20, 8, Report(7, 701, "done"));
  run retiredTwo <- child(10, 20, 9, Retire(7));
  run unknown <- child(11, 10, 10, Dispatch(99, 20, briefOne));
  run pausedUnknown <- child(12, 20, 11, Pause(11));
  run reportedUnknown <- child(13, 20, 12, Report(11, 701, "done"));
  run retiredUnknown <- child(14, 20, 13, Retire(11));
  (Cons(
    opened,
    Cons(
      early,
      Cons(
        one,
        Cons(
          pausedOne,
          Cons(
            reportedOne,
            Cons(
              retiredOne,
              Cons(
                two,
                Cons(
                  pausedTwo,
                  Cons(
                    reportedTwo,
                    Cons(
                      retiredTwo,
                      Cons(
                        unknown,
                        Cons(pausedUnknown, Cons(reportedUnknown, Cons(retiredUnknown, Nil)))
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  ) : List(Commit))
}

/// The early report is not current; edition 1 offers no pause; every move
/// under edition 99, its dispatch first, is refused as an unknown edition.
@[ runs("Some(Cons(RefusedAt(2, NotCurrent), Cons(RefusedAt(4, Protocol(1, PauseMove, WrongLabel)), Cons(RefusedAt(11, Protocol(99, DispatchMove, UnknownEdition)), Cons(RefusedAt(12, Protocol(99, PauseMove, UnknownEdition)), Cons(RefusedAt(13, Protocol(99, ReportMove, UnknownEdition)), Cons(RefusedAt(14, Protocol(99, RetireMove, UnknownEdition)), Nil)))))))") ]
def editionRefused : () => Maybe(List(RefusedCommit)) ;
def editionRefused = thunk {
  run commits <- editionCommits();
  run folded <- fold(100, commits);
  become refusedOf(folded)
} ;

/// The edition-2 attempt, paused, reported and retired, stays current past
