@[ runs("Some(Attempt(7, 2, BriefAt(\"domhringr://100/briefs/one\"), Vacated(20, 10), ReportedBy(9), Unchecked))") ]
def editionCurrent : () => Maybe(Current) ;
def editionCurrent = thunk {
  run commits <- editionCommits();
  run folded <- fold(100, commits);
  become currentOf(folded)
} ;

/// `a_judge_rules_on_the_current_dispatch`: the judge `50` rules; a stranger
/// and the owner sign verdicts naming it; the seat retires before reporting,
/// and the stranger rules in its own name after. The rubric is 903 and the
/// transcript 705.
@[ checks ]
def judgeCommits() -> -F List(Commit) {
  run opened <- rooted(1, 10, Open(Signed(100, 10)));
  run dispatched <- child(2, 10, 1, Dispatch(1, 20, briefOne));
  run judged <- child(3, 50, 2, Verdict(2, 50, 903, 705, rulings));
  run forged <- child(4, 70, 2, Verdict(2, 50, 903, 705, rulings));
  run byOwner <- child(5, 10, 2, Verdict(2, 50, 903, 705, rulings));
  run retired <- child(6, 20, 3, Retire(2));
  run after <- child(7, 70, 6, Verdict(2, 70, 903, 705, rulings));
  (Cons(
    opened,
    Cons(dispatched, Cons(judged, Cons(forged, Cons(byOwner, Cons(retired, Cons(after, Nil))))))
  ) : List(Commit))
}

/// A verdict signed by any key but its judge's, the owner's among them, is
/// refused, and the retirement before a report at its selection.
