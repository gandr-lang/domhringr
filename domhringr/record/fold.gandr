} ;

/// `a_gradings_composition_is_checked_before_it_advances_the_task`, for the
/// grades met and refused: each composition but refused is miscomposed, in
/// descent, and the correct one is admitted.
@[ checks ]
def composedCommits() -> -F List(Commit) {
  run opened <- rooted(1, 10, Open(Signed(100, 10)));
  run dispatched <- child(2, 10, 1, Dispatch(1, 20, briefOne));
  run judged <- child(3, 50, 2, Verdict(2, 50, 903, 705, rulings));
  run asMet <- child(4, 50, 3, Graded(3, Cons(Met, Cons(Refused, Nil)), Met));
  run asUnmet <- child(5, 50, 4, Graded(3, Cons(Met, Cons(Refused, Nil)), Unmet));
  run asUndecided <- child(6, 50, 5, Graded(3, Cons(Met, Cons(Refused, Nil)), Undecided));
  run admitted <- child(7, 50, 6, Graded(3, Cons(Met, Cons(Refused, Nil)), Refused));
  (Cons(
    opened,
    Cons(
      dispatched,
      Cons(judged, Cons(asMet, Cons(asUnmet, Cons(asUndecided, Cons(admitted, Nil)))))
    )
  ) : List(Commit))
}

/// Each misstated composition is refused.
@[ runs("Some(Cons(RefusedAt(4, Miscomposed), Cons(RefusedAt(5, Miscomposed), Cons(RefusedAt(6, Miscomposed), Nil))))") ]
def composedRefused : () => Maybe(List(RefusedCommit)) ;
def composedRefused = thunk {
  run commits <- composedCommits();
  run folded <- fold(100, commits);
  become refusedOf(folded)
} ;

/// The correct composition advances the attempt to graded.
@[ runs("Some(Attempt(2, 1, BriefAt(\"domhringr://100/briefs/one\"), Held(20), Awaited, GradedBy(7, Refused)))") ]
def composedCurrent : () => Maybe(Current) ;
def composedCurrent = thunk {
  run commits <- composedCommits();
  run folded <- fold(100, commits);
  become currentOf(folded)
} ;

/// `task_channels_refuse_second_choices`, in descent: the judge grades its
/// verdict twice, the owner decides to land twice and lands twice.
@[ checks ]
def secondCommits() -> -F List(Commit) {
  run opened <- rooted(1, 10, Open(Signed(100, 10)));
  run dispatched <- child(2, 10, 1, Dispatch(1, 20, briefOne));
  run judged <- child(3, 50, 2, Verdict(2, 50, 903, 705, rulings));
  run firstGrade <- child(4, 50, 3, Graded(3, Cons(Met, Cons(Refused, Nil)), Refused));
  run secondGrade <- child(5, 50, 4, Graded(3, Cons(Met, Cons(Refused, Nil)), Refused));
  run firstDecision <- merged(6, 10, 4, 5, Decide(2, 10, Land));
  run secondDecision <- child(7, 10, 6, Decide(2, 10, Land));
  run firstLanding <- merged(8, 10, 6, 7, Landed(6, revision));
  run secondLanding <- child(9, 10, 8, Landed(6, revision));
  (Cons(
    opened,
    Cons(
      dispatched,
      Cons(
        judged,
        Cons(
          firstGrade,
          Cons(
            secondGrade,
            Cons(firstDecision, Cons(secondDecision, Cons(firstLanding, Cons(secondLanding, Nil))))
          )
        )
      )
    )
  ) : List(Commit))
}

/// A second grading resumes an ended judge channel, a second decision meets
/// a channel owing its landing, and a second landing an ended one.
@[ runs("Some(Cons(RefusedAt(5, Protocol(1, GradedMove, ResumeAfterEnd)), Cons(RefusedAt(7, Protocol(1, DecideMove(ToLand), WrongDirection)), Cons(RefusedAt(9, Protocol(1, LandedMove, ResumeAfterEnd)), Nil))))") ]
def secondRefused : () => Maybe(List(RefusedCommit)) ;
def secondRefused = thunk {
  run commits <- secondCommits();
  run folded <- fold(100, commits);
  become refusedOf(folded)
} ;

/// `an_operator_decides_on_the_current_dispatch`, the owner deciding: the
/// owner decides to land; the seat, a stranger and a member signing for the
/// owner decide; the owner decides on a dispatch never made, dispatches
/// again and decides on the superseded dispatch.
@[ checks ]
def decisionCommits() -> -F List(Commit) {
  run opened <- rooted(1, 10, Open(Signed(100, 10)));
  run granted <- child(2, 10, 1, Grant(50));
  run dispatched <- child(3, 10, 2, Dispatch(1, 20, briefOne));
  run admitted <- child(4, 10, 3, Decide(3, 10, Land));
  run bySeat <- child(5, 20, 3, Decide(3, 20, Land));
  run byStranger <- child(6, 70, 3, Decide(3, 70, Abandon));
  run forged <- child(7, 50, 3, Decide(3, 10, Land));
  run unknown <- child(8, 10, 3, Decide(9999, 10, Land));
  run second <- child(9, 10, 4, Dispatch(1, 20, briefOne));
  run stale <- child(10, 10, 9, Decide(3, 10, Abandon));
  (Cons(
    opened,
    Cons(
      granted,
      Cons(
        dispatched,
        Cons(
          admitted,
          Cons(
            bySeat,
            Cons(byStranger, Cons(forged, Cons(unknown, Cons(second, Cons(stale, Nil)))))
          )
        )
      )
    )
  ) : List(Commit))
}

/// The seat and the stranger hold no operator role, the member signs for
/// another operator, and the decisions on a dispatch never made or
/// superseded are not current.
@[ runs("Some(Cons(RefusedAt(5, NoAuthority), Cons(RefusedAt(6, NoAuthority), Cons(RefusedAt(7, NotOperator), Cons(RefusedAt(8, NotCurrent), Cons(RefusedAt(10, NotCurrent), Nil))))))") ]
def decisionRefused : () => Maybe(List(RefusedCommit)) ;
def decisionRefused = thunk {
  run commits <- decisionCommits();
  run folded <- fold(100, commits);
  become refusedOf(folded)
} ;

/// `a_landing_carries_out_a_decision_to_land`, deciding to land: the owner
/// lands; the seat and a member who did not decide land; the owner lands
/// with no decision and concurrently with it, dispatches again and lands
/// after.
@[ checks ]
def landingCommits() -> -F List(Commit) {
  run opened <- rooted(1, 10, Open(Signed(100, 10)));
  run granted <- child(2, 10, 1, Grant(50));
  run dispatched <- child(3, 10, 2, Dispatch(1, 20, briefOne));
  run decided <- child(4, 10, 3, Decide(3, 10, Land));
  run landing <- child(5, 10, 4, Landed(4, revision));
  run bySeat <- child(6, 20, 4, Landed(4, revision));
  run byMember <- child(7, 50, 4, Landed(4, revision));
  run undecided <- child(8, 10, 3, Landed(9999, revision));
  run concurrent <- child(9, 10, 3, Landed(4, revision));
  run second <- child(10, 10, 5, Dispatch(1, 20, briefOne));
  run stale <- child(11, 10, 10, Landed(4, revision));
  (Cons(
    opened,
    Cons(
      granted,
      Cons(
        dispatched,
        Cons(
          decided,
          Cons(
            landing,
            Cons(
              bySeat,
              Cons(byMember, Cons(undecided, Cons(concurrent, Cons(second, Cons(stale, Nil)))))
            )
          )
        )
      )
    )
  ) : List(Commit))
}

/// A landing by anyone but the deciding operator is refused; one with no
/// decision in its past replays on an empty decision channel; one after a
/// later dispatch is not current.
@[ runs("Some(Cons(RefusedAt(6, NotOperator), Cons(RefusedAt(7, NotOperator), Cons(RefusedAt(8, Protocol(1, LandedMove, WrongDirection)), Cons(RefusedAt(9, Protocol(1, LandedMove, WrongDirection)), Cons(RefusedAt(11, NotCurrent), Nil))))))") ]
def landingRefused : () => Maybe(List(RefusedCommit)) ;
def landingRefused = thunk {
  run commits <- landingCommits();
  run folded <- fold(100, commits);
  become refusedOf(folded)
} ;

/// The decision and its landing are the task's steps past the dispatch.
@[ runs("Some(Cons(StepAt(3, DispatchStep(1, 20, BriefAt(\"domhringr://100/briefs/one\"))), Cons(StepAt(4, DecideStep(3, 10, Land)), Cons(StepAt(5, LandedStep(3, 4, 10, \"0123456789abcdef0123456789abcdef01234567\")), Cons(StepAt(10, DispatchStep(1, 20, BriefAt(\"domhringr://100/briefs/one\"))), Nil)))))") ]
def landingSteps : () => Maybe(List(Stepped)) ;
def landingSteps = thunk {
  run commits <- landingCommits();
  run folded <- fold(100, commits);
  become stepsOf(folded)
} ;

/// `a_landing_carries_out_a_decision_to_land`, deciding to rework: the
/// landing resumes the ended decision channel.
@[ runs("Some(Cons(RefusedAt(5, Protocol(1, LandedMove, ResumeAfterEnd)), Nil))") ]
def reworkRefused : () => Maybe(List(RefusedCommit)) ;
def reworkRefused = thunk {
  run opened <- rooted(1, 10, Open(Signed(100, 10)));
  run granted <- child(2, 10, 1, Grant(50));
  run dispatched <- child(3, 10, 2, Dispatch(1, 20, briefOne));
  run decided <- child(4, 10, 3, Decide(3, 10, Rework("lint red")));
  run landing <- child(5, 10, 4, Landed(4, revision));
  run folded <- fold(
    100,
    Cons(opened, Cons(granted, Cons(dispatched, Cons(decided, Cons(landing, Nil)))))
  );
  become refusedOf(folded)
} ;

/// `an_attempt_advances_through_its_lifecycle`: a dispatch, its report, a
/// verification, a verdict, its grading, a later verification and a
/// decision to rework; a fresh dispatch, a decision to land and the
/// landing.
@[ checks ]
def lifecycleCommits() -> -F List(Commit) {
  run opened <- rooted(1, 10, Open(Signed(100, 10)));
  run first <- child(2, 10, 1, Dispatch(1, 20, briefOne));
  run reported <- child(3, 20, 2, Report(2, 701, "done"));
  run verifying <- child(4, 50, 3, Verified(2, 50, 904, "test", 706, Exited(0)));
  run judged <- child(5, 50, 4, Verdict(2, 50, 903, 705, rulings));
  run grading <- child(6, 50, 5, Graded(5, Cons(Met, Cons(Refused, Nil)), Refused));
  run reverifying <- child(7, 50, 6, Verified(2, 50, 904, "test", 706, Exited(1)));
  (Cons(
    opened,
    Cons(
      first,
      Cons(reported, Cons(verifying, Cons(judged, Cons(grading, Cons(reverifying, Nil)))))
    )
  ) : List(Commit))
}

/// A later verification ranks below the grading.
@[ runs("Some(Attempt(2, 1, BriefAt(\"domhringr://100/briefs/one\"), Held(20), ReportedBy(3), GradedBy(6, Refused)))") ]
def lifecycleGraded : () => Maybe(Current) ;
def lifecycleGraded = thunk {
  run commits <- lifecycleCommits();
  run folded <- fold(100, commits);
  become currentOf(folded)
} ;

/// The fresh dispatch after rework lands, every step admitted.
@[ runs("Some(Attempt(9, 1, BriefAt(\"domhringr://100/briefs/one\"), Held(20), Awaited, LandedBy(11, \"0123456789abcdef0123456789abcdef01234567\")))") ]
def lifecycleLanded : () => Maybe(Current) ;
def lifecycleLanded = thunk {
  run commits <- lifecycleCommits();
  run reworked <- child(8, 10, 7, Decide(2, 10, Rework("lint red")));
  run next <- child(9, 10, 8, Dispatch(1, 20, briefOne));
  run land <- child(10, 10, 9, Decide(9, 10, Land));
  run landing <- child(11, 10, 10, Landed(10, revision));
  run all <- append(Commit, commits, reworked);
  run more <- append(Commit, all, next);
  run most <- append(Commit, more, land);
  run every <- append(Commit, most, landing);
  run folded <- fold(100, every);
  become currentOf(folded)
} ;

/// `a_duplicate_operation_keeps_the_first`, in descent: two notes carrying
/// one fence.
@[ checks ]
def duplicateCommits() -> -F List(Commit) {
  run opened <- rooted(1, 10, Open(Signed(100, 10)));
  run first <- fencedChild(2, 10, 1, 77, Note("first"));
  run again <- fencedChild(3, 10, 2, 77, Note("again"));
  (Cons(opened, Cons(first, Cons(again, Nil))) : List(Commit))
}

/// The ancestor keeps the operation.
@[ runs("Some(Cons(NotedBy(10, \"first\"), Nil))") ]
def duplicateNotes : () => Maybe(List(Noted)) ;
def duplicateNotes = thunk {
  run commits <- duplicateCommits();
  run folded <- fold(100, commits);
  become notesOf(folded)
} ;

/// The descendant repeating it is a duplicate of the first.
@[ runs("Some(Cons(RefusedAt(3, Duplicate(2)), Nil))") ]
def duplicateRefused : () => Maybe(List(RefusedCommit)) ;
def duplicateRefused = thunk {
  run commits <- duplicateCommits();
  run folded <- fold(100, commits);
  become refusedOf(folded)
} ;

/// `a_duplicate_operation_keeps_the_first`, a refused receipt claiming no
/// operation: a non-member's note, then the owner's under the same fence.
@[ runs("Some(Cons(RefusedAt(2, NoAuthority), Nil))") ]
def squattedFence : () => Maybe(List(RefusedCommit)) ;
def squattedFence = thunk {
  run opened <- rooted(1, 10, Open(Signed(100, 10)));
  run squat <- fencedChild(2, 20, 1, 78, Note("squat"));
  run owned <- fencedChild(3, 10, 2, 78, Note("owned"));
  run folded <- fold(100, Cons(opened, Cons(squat, Cons(owned, Nil))));
  become refusedOf(folded)
} ;

/// `a_receipt_under_the_wrong_tree_is_refused`: a note naming the tree
/// `200` is refused naming it.
@[ runs("Some(Cons(RefusedAt(2, WrongTree(200)), Nil))") ]
def astray : () => Maybe(List(RefusedCommit)) ;
def astray = thunk {
  run opened <- rooted(1, 10, Open(Signed(100, 10)));
  run folded <- fold(
    100,
    Cons(
      opened,
      Cons(Committed(2, 10, Cons(1, Nil), Decoded(Receipt(200, 2, Note("astray")))), Nil)
    )
  );
  become refusedOf(folded)
} ;

/// `the_smallest_root_open_names_the_owner`: two root Opens and a reopening;
/// the Open placed first names the owner.
@[ checks ]
def opensCommits() -> -F List(Commit) {
  run byA <- rooted(1, 10, Open(Signed(100, 10)));
  run byB <- rooted(2, 20, Open(Signed(100, 20)));
  run reopened <- child(3, 10, 1, Open(Signed(100, 10)));
  (Cons(byA, Cons(byB, Cons(reopened, Nil))) : List(Commit))
}

/// The root Open placed first names the owner.
@[ runs("Some(10)") ]
def opensOwner : () => Maybe(Integer) ;
def opensOwner = thunk {
  run commits <- opensCommits();
  run folded <- fold(100, commits);
  become ownerOf(folded)
} ;

/// Every other proved Open, root or not, is a second Open.
@[ runs("Some(Cons(RefusedAt(2, SecondOpen), Cons(RefusedAt(3, SecondOpen), Nil)))") ]
def opensRefused : () => Maybe(List(RefusedCommit)) ;
def opensRefused = thunk {
  run commits <- opensCommits();
  run folded <- fold(100, commits);
  become refusedOf(folded)
} ;

/// `an_open_proved_by_another_key_is_refused`: an Open proved by the tree
/// `200`'s key opens nothing.
@[ runs("None") ]
def forgedOpen : () => Maybe(Integer) ;
def forgedOpen = thunk {
  run forged <- rooted(1, 10, Open(Signed(200, 10)));
  run folded <- fold(100, Cons(forged, Nil));
  become ownerOf(folded)
} ;

/// An Open proved for another author opens nothing.
@[ runs("None") ]
def replayedOpen : () => Maybe(Integer) ;
def replayedOpen = thunk {
  run replayed <- rooted(2, 20, Open(Signed(100, 10)));
  run folded <- fold(100, Cons(replayed, Nil));
  become ownerOf(folded)
} ;

/// Beside the Open the tree key proved for its author, both are refused as
/// bad proofs.
@[ runs("Some(Cons(RefusedAt(1, BadProof), Cons(RefusedAt(2, BadProof), Nil)))") ]
def badProofs : () => Maybe(List(RefusedCommit)) ;
def badProofs = thunk {
  run forged <- rooted(1, 10, Open(Signed(200, 10)));
  run replayed <- rooted(2, 20, Open(Signed(100, 10)));
  run opened <- rooted(3, 10, Open(Signed(100, 10)));
  run folded <- fold(100, Cons(forged, Cons(replayed, Cons(opened, Nil))));
  become refusedOf(folded)
} ;

/// `an_undecodable_blob_is_refused_and_an_unopened_tree_has_no_view`: a blob
/// that is no receipt is refused.
@[ runs("Some(Cons(RefusedAt(2, Undecodable), Nil))") ]
def garbled : () => Maybe(List(RefusedCommit)) ;
def garbled = thunk {
  run opened <- rooted(1, 10, Open(Signed(100, 10)));
  run folded <- fold(100, Cons(opened, Cons(Committed(2, 10, Cons(1, Nil), Garbled), Nil)));
  become refusedOf(folded)
} ;

/// An Open of another tree does not open this one.
@[ runs("None") ]
def foreignOpen : () => Maybe(Integer) ;
def foreignOpen = thunk {
  run orphan <- child(2, 10, 1, Note("orphan"));
  run folded <- fold(
    100,
    Cons(
      Committed(1, 10, Nil, Decoded(Receipt(200, 1, Open(Signed(200, 10))))),
      Cons(orphan, Nil)
    )
  );
  become ownerOf(folded)
} ;

/// Nothing opens an empty tree.
@[ runs("None") ]
def empty : () => Maybe(Integer) ;
def empty = thunk {
  run folded <- fold(100, Nil);
  become ownerOf(folded)
} ;
