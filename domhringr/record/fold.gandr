} ;

/// `a_handoff_before_report_is_a_named_protocol_refusal`: `50` reports on
/// the seat's dispatch; the seat hands off before reporting, then reports;
/// the owner seizes the slot, and `50` reports.
@[ checks ]
def earlyCommits() -> -F List(Commit) {
  run opened <- rooted(1, 10, Open(Signed(100, 10)));
  run dispatched <- child(2, 10, 1, Dispatch(1, 20, briefOne));
  run early <- child(3, 50, 2, Report(2, 703, "early"));
  run handed <- child(4, 20, 2, Handoff(2, 50));
  run byFormer <- child(5, 20, 4, Report(2, 704, "late"));
  run byOwner <- child(6, 10, 4, Handoff(2, 10));
  run reported <- child(7, 50, 4, Report(2, 701, "done"));
  (Cons(
    opened,
    Cons(dispatched, Cons(early, Cons(handed, Cons(byFormer, Cons(byOwner, Cons(reported, Nil))))))
  ) : List(Commit))
}

