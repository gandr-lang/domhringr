/// `handoff_closes_the_play_instead_of_permitting_a_second_handoff`: the
/// seat reports and hands off to `50`, which hands back, reports and
/// retires after the play ended.
@[ checks ]
def handoffCommits() -> -F List(Commit) {
  run opened <- rooted(1, 10, Open(Signed(100, 10)));
  run dispatched <- child(2, 10, 1, Dispatch(1, 20, briefOne));
  run reported <- child(3, 20, 2, Report(2, 701, "done"));
  run handed <- child(4, 20, 3, Handoff(2, 50));
  run repeated <- child(5, 50, 4, Handoff(2, 20));
  run late <- child(6, 50, 5, Report(2, 704, "late"));
  run retired <- child(7, 50, 6, Retire(2));
  (Cons(
    opened,
    Cons(dispatched, Cons(reported, Cons(handed, Cons(repeated, Cons(late, Cons(retired, Nil))))))
  ) : List(Commit))
}

/// Every move after the handoff resumes an ended play.
@[ runs("Some(Cons(RefusedAt(5, Protocol(1, HandoffMove, ResumeAfterEnd)), Cons(RefusedAt(6, Protocol(1, ReportMove, ResumeAfterEnd)), Cons(RefusedAt(7, Protocol(1, RetireMove, ResumeAfterEnd)), Nil))))") ]
def handoffRefused : () => Maybe(List(RefusedCommit)) ;
def handoffRefused = thunk {
  run commits <- handoffCommits();
  run folded <- fold(100, commits);
  become refusedOf(folded)
} ;

/// The slot is with the recipient, the attempt answered by the report.
