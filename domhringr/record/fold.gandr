/// `a_report_on_a_superseded_dispatch_is_refused`: two dispatches in
/// descent; the first seat reports after the second, on a dispatch never
/// made, and concurrently with the second.
@[ checks ]
def supersededCommits() -> -F List(Commit) {
  run opened <- rooted(1, 10, Open(Signed(100, 10)));
  run first <- child(2, 10, 1, Dispatch(1, 20, briefOne));
  run second <- child(3, 10, 2, Dispatch(1, 50, briefOne));
  run stale <- child(4, 20, 3, Report(2, 707, "stale"));
  run unknown <- child(5, 20, 2, Report(9999, 708, "unknown"));
  run concurrent <- child(6, 20, 2, Report(2, 709, "concurrent"));
  (Cons(
    opened,
    Cons(first, Cons(second, Cons(stale, Cons(unknown, Cons(concurrent, Nil)))))
  ) : List(Commit))
}

/// The report after the later dispatch and the one on no dispatch are not
/// current.
