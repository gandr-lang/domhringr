@[ runs("Some(Cons(StepAt(2, DispatchStep(1, 20, BriefAt(\"domhringr://100/briefs/one\"))), Cons(StepAt(3, VerdictStep(2, 50, 903, 705, Cons(OnQuestion(901, Read(Cons(250000, Cons(750000, Nil)), 0)), Cons(OnQuestion(902, Unread(NoLetter)), Nil)))), Cons(StepAt(7, VerdictStep(2, 70, 903, 705, Cons(OnQuestion(901, Read(Cons(250000, Cons(750000, Nil)), 0)), Cons(OnQuestion(902, Unread(NoLetter)), Nil)))), Nil))))") ]
