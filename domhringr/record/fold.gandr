  run folded <- fold(100, commits);
  become currentOf(folded)
} ;

/// `a_runner_verifies_on_the_current_dispatch`: the runner `50` passes; a
/// stranger and the owner sign verifications naming it; the seat retires
/// before reporting; the runner fails, the owner dispatches again, and the
/// runner verifies the superseded dispatch. The playbook is 904 and the
/// output 706.
@[ checks ]
def runnerCommits() -> -F List(Commit) {
  run opened <- rooted(1, 10, Open(Signed(100, 10)));
  run first <- child(2, 10, 1, Dispatch(1, 20, briefOne));
  run passed <- child(3, 50, 2, Verified(2, 50, 904, "test", 706, Exited(0)));
  run forged <- child(4, 70, 2, Verified(2, 50, 904, "test", 706, Exited(0)));
  run byOwner <- child(5, 10, 2, Verified(2, 50, 904, "test", 706, Exited(0)));
  run retired <- child(6, 20, 3, Retire(2));
  run failed <- child(7, 50, 6, Verified(2, 50, 904, "test", 706, Exited(1)));
  run second <- child(8, 10, 7, Dispatch(1, 20, briefOne));
  run stale <- child(9, 50, 8, Verified(2, 50, 904, "test", 706, Exited(0)));
  (Cons(
    opened,
    Cons(
      first,
      Cons(
        passed,
        Cons(forged, Cons(byOwner, Cons(retired, Cons(failed, Cons(second, Cons(stale, Nil))))))
      )
    )
  ) : List(Commit))
}

/// A verification signed by any key but its runner's, the owner's among
