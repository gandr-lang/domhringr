// The checks the fold applies to a receipt and the refusal each yields: the
// causal past a commit reads its authority from, the slot it holds, and the
// grading and landing checks. It follows `fold.rs` of `domhringr-record-tree`
// (`crates/record-tree/src/fold.rs`: `Refusal`, `Course`, `Past`,
// `grading`, `landing`); each task channel's moves replay through the arena's
// monitor (`../arena/protocol.gandr`).
//
// A refusal is data the fold returns, never a fault. A protocol refusal names
// the dispatch's edition, the move and the reason the monitor gives; the
// monitor's endpoint index and expected action are not kept.

// Lists, and the rubric the grades come from.
import "../strategy/rubric.gandr" ;

// Rulings and grades.
import "../strategy/grade.gandr" ;

// A rubric's grades composed.
import "../strategy/compose.gandr" ;

// The receipt kinds.
import "./receipt.gandr" ;

// The channels' moves and the monitor that replays them.
import "../arena/protocol.gandr" ;

/// Why the fold gives a commit no meaning.
@[ checks ]
data Refusal : Type {
  Protocol : (edition : Integer, move : Move, reason : Reason) --> Refusal;
  Undecodable : Refusal;
  WrongTree : (named : Integer) --> Refusal;
  Duplicate : (first : Integer) --> Refusal;
  NoAuthority : Refusal;
  BadProof : Refusal;
  SecondOpen : Refusal;
  NotOwner : Refusal;
  ForeignEndpoint : Refusal;
  ForeignPresence : Refusal;
  NotCurrent : Refusal;
  NotHolder : Refusal;
  NotJudge : Refusal;
  NotRunner : Refusal;
  Misgraded : Refusal;
  Miscomposed : Refusal;
  NotOperator : Refusal;
}

/// A check's answer: it passes, or it refuses for this reason.
@[ checks ]
data Outcome : Type {
  Pass : Outcome;
  Fail : (refusal : Refusal) --> Outcome;
}

/// Whether `x` is in `xs`.
@[ checks ]
def rec member(x : Integer, xs : List(Integer)) -> -F Bool {
  case xs {
    Nil => false,
    Cons(y, rest) => case x == y {
      true => true,
      false => become member[<](x, rest)
    }
  }
}

/// `xs`, held in ascending order without repetition, with `x` added in its
/// place.
@[ checks ]
def rec insert(x : Integer, xs : List(Integer)) -> -F List(Integer) {
  case xs {
    Nil => Cons(x, Nil),
    Cons(y, rest) => case x < y {
      true => Cons(x, xs),
      false => case x == y {
        true => xs,
        false => {
          run later <- insert[<](x, rest);
          Cons(y, later)
        }
      }
    }
  }
}

/// The union of two ascending lists, ascending.
@[ checks ]
def rec union(xs : List(Integer), ys : List(Integer)) -> -F List(Integer) {
  case xs {
    Nil => ys,
    Cons(x, rest) => {
      run joined <- union[<](rest, ys);
      become insert(x, joined)
    }
  }
}

/// Who a dispatch's slot is with: a seat, or nobody once its last holder
/// retired.
@[ checks ]
data Holder : Type {
  SeatHolds : (seat : Integer) --> Holder;
  Vacant : Holder;
}

/// The admitted dispatch last in canonical order in a commit's causal past,
/// with where it was placed, where the slot last moved and who holds it, or
/// none.
@[ checks ]
data Course : Type {
  Idle : Course;
  Dispatched : (placed : Integer, dispatch : Integer, moved : Integer, holder : Holder) --> Course;
}

/// The later of two courses, the order two pasts merge by: a later dispatch
/// supersedes an earlier one, and of one dispatch the slot's later move wins.
@[ checks ]
def later(a : Course, b : Course) -> -F Course {
  case a {
    Idle => b,
    Dispatched(placed, dispatch, moved, holder) => case b {
      Idle => a,
      Dispatched(otherPlaced, otherDispatch, otherMoved, otherHolder) => case placed < otherPlaced {
        true => b,
        false => case placed == otherPlaced {
          true => case moved < otherMoved {
            true => b,
            false => a
          },
          false => a
        }
      }
    }
  }
}

/// This course with its slot moved to `holder` by the commit placed at
/// `place`; no course stays none.
@[ checks ]
def moved(course : Course, place : Integer, holder : Holder) -> -F Course {
  case course {
    Idle => Idle,
    Dispatched(placed, dispatch, before, was) => Dispatched(placed, dispatch, place, holder)
  }
}

/// Whether `author` may report on, hand off, retire from or pause
/// `dispatch` here: the course is of that dispatch and `author` holds its
/// slot.
@[ checks ]
def answerable(course : Course, dispatch : Integer, author : Integer) -> -F Outcome {
  case course {
    Idle => Fail(NotCurrent),
    Dispatched(placed, current, moved, holder) => case current == dispatch {
      true => case holder {
        SeatHolds(seat) => case seat == author {
          true => Pass,
          false => Fail(NotHolder)
        },
        Vacant => Fail(NotHolder)
      },
      false => Fail(NotCurrent)
    }
  }
}

/// Whether `dispatch` is the course's, whoever holds its slot.
@[ checks ]
def current(course : Course, dispatch : Integer) -> -F Outcome {
  case course {
    Idle => Fail(NotCurrent),
    Dispatched(placed, held, moved, holder) => case held == dispatch {
      true => Pass,
      false => Fail(NotCurrent)
    }
  }
}

/// What a commit's causal past, the commit itself included, hands its
/// children: the peers granted, the peers given a slot, the admitted
/// verdicts and decisions, and the course.
@[ checks ]
data Past : Type {
  Past : (
    grantees : List(Integer),
    seats : List(Integer),
    verdicts : List(Integer),
    decisions : List(Integer),
    course : Course
  ) --> Past;
}

/// The past of a commit with no parent placed.
@[ checks ]
def emptyPast = (Past(Nil, Nil, Nil, Nil, Idle) : Past);

/// Two pasts merged: the union of each set, and the later course.
@[ checks ]
def merge(a : Past, b : Past) -> -F Past {
  case a {
    Past(grantees, seats, verdicts, decisions, course) => case b {
      Past(moreGrantees, moreSeats, moreVerdicts, moreDecisions, otherCourse) => {
        run g <- union(grantees, moreGrantees);
        run s <- union(seats, moreSeats);
        run v <- union(verdicts, moreVerdicts);
        run d <- union(decisions, moreDecisions);
        run c <- later(course, otherCourse);
        Past(g, s, v, d, c)
      }
    }
  }
}

/// Whether two grades are one.
@[ checks ]
def same(a : Grade, b : Grade) -> -F Bool {
  case a {
    Met => case b {
      Met => true,
      _ => false
    },
    Unmet => case b {
      Unmet => true,
      _ => false
    },
    Undecided => case b {
      Undecided => true,
      _ => false
    },
    Refused => case b {
      Refused => true,
      _ => false
    }
  }
}

/// Whether the judge read no ruling on a question.
@[ checks ]
def unread(ruled : Ruled) -> -F Bool {
  case ruled {
    OnQuestion(question, ruling) => case ruling {
      Read(probabilities, outside) => false,
      Unread(reason) => true
    }
  }
}

/// Whether grades answer a verdict's rulings: one grade per ruling, refused
/// exactly where the judge read no ruling.
@[ checks ]
def rec answers(grades : List(Grade), rulings : List(Ruled)) -> -F Bool {
  case grades {
    Nil => case rulings {
      Nil => true,
      Cons(ruled, rest) => false
    },
    Cons(grade, moreGrades) => case rulings {
      Nil => false,
      Cons(ruled, moreRulings) => {
        run refused <- same(grade, Refused);
        run blank <- unread(ruled);
        case refused {
          true => case blank {
            true => become answers[<](moreGrades, moreRulings),
            false => false
          },
          false => case blank {
            true => false,
            false => become answers[<](moreGrades, moreRulings)
          }
        }
      }
    }
  }
}

/// A grading of a verdict ruled by `judge` with `rulings`, by `author`: the
/// judge's, answering the rulings, its composition the conjunction of its
/// grades.
@[ checks ]
def grading(
  judge : Integer,
  rulings : List(Ruled),
  author : Integer,
  grades : List(Grade),
  composed : Grade
) -> -F Outcome {
  case author == judge {
    false => Fail(NotJudge),
    true => case answers(grades, rulings) {
      false => Fail(Misgraded),
      true => {
        run conjunction <- compose(grades);
        case same(composed, conjunction) {
          true => Pass,
          false => Fail(Miscomposed)
        }
      }
    }
  }
}

/// A landing of a decision by `operator`, by `author`: the deciding
/// operator's alone.
@[ checks ]
def landing(operator : Integer, author : Integer) -> -F Outcome {
  case author == operator {
    true => Pass,
    false => Fail(NotOperator)
  }
}
