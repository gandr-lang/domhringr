// The checks the fold applies to a receipt and the refusal each yields: the
// causal past a commit reads its authority from, the slot it holds, the
// replay of each task channel's moves, and the grading and landing checks.
// It follows `fold.rs` of `domhringr-record-tree`
// (`crates/record-tree/src/fold.rs`: `Refusal`, `Course`, `Past`,
// `grading`, `landing`) and the channel protocols of
// `domhringr-arena-session` (`crates/arena-session/src/lib.rs`).
//
// A refusal is data the fold returns, never a fault. A protocol refusal names
// the dispatch's edition, the move and the reason the monitor gives; the
// monitor's endpoint index and expected action are not kept. The channels
// replay as the session types the arena compiles, written here as their
// states: editions 1 and 2 are known, as in the peer's build, and every move
// under another edition is refused by name.

// Lists, and the rubric the grades come from.
import "../strategy/rubric.gandr" ;

// Rulings and grades.
import "../strategy/grade.gandr" ;

// A rubric's grades composed.
import "../strategy/compose.gandr" ;

// The receipt kinds.
import "./receipt.gandr" ;

/// The operator's choice on a decision channel.
@[ checks ]
data Choice : Type {
  ToLand : Choice;
  ToRework : Choice;
  ToAbandon : Choice;
}

/// A receipt's move on a task channel.
@[ checks ]
data Move : Type {
  DispatchMove : Move;
  ReportMove : Move;
  HandoffMove : Move;
  RetireMove : Move;
  PauseMove : Move;
  VerdictMove : Move;
  GradedMove : Move;
  VerifiedMove : Move;
  DecideMove : (choice : Choice) --> Move;
  LandedMove : Move;
}

/// Why the monitor refuses a move.
@[ checks ]
data Reason : Type {
  UnknownEdition : Reason;
  WrongLabel : Reason;
  ResumeAfterEnd : Reason;
  WrongPayloadIdentity : Reason;
  WrongDirection : Reason;
}

/// Why the fold gives a commit no meaning.
@[ checks ]
data Refusal : Type {
  Protocol : (edition : Integer, move : Move, reason : Reason) --> Refusal;
  Undecodable : Refusal;
  WrongTree : (named : Integer) --> Refusal;
  Duplicate : (first : Integer) --> Refusal;
  NoAuthority : Refusal;
  BadProof : Refusal;
  SecondOpen : Refusal;
  NotOwner : Refusal;
  ForeignEndpoint : Refusal;
  ForeignPresence : Refusal;
  NotCurrent : Refusal;
  NotHolder : Refusal;
  NotJudge : Refusal;
  NotRunner : Refusal;
  Misgraded : Refusal;
  Miscomposed : Refusal;
  NotOperator : Refusal;
}

/// A check's answer: it passes, or it refuses for this reason.
@[ checks ]
data Outcome : Type {
  Pass : Outcome;
  Fail : (refusal : Refusal) --> Outcome;
}

/// Whether `x` is in `xs`. A failing comparison answers for itself where
/// `false` would stand (gandr #1831).
@[ checks ]
def rec member(x : Integer, xs : List(Integer)) -> -F Bool {
  case xs {
    Nil => x < x,
    Cons(y, rest) => case x == y {
      true => x == y,
      false => become member[<](x, rest)
    }
  }
}

/// `xs`, held in ascending order without repetition, with `x` added in its
/// place.
@[ checks ]
def rec insert(x : Integer, xs : List(Integer)) -> -F List(Integer) {
  case xs {
    Nil => (Cons(x, Nil) : List(Integer)),
    Cons(y, rest) => case x < y {
      true => (Cons(x, xs) : List(Integer)),
      false => case x == y {
        true => xs,
        false => {
          run later <- insert[<](x, rest);
          (Cons(y, later) : List(Integer))
        }
      }
    }
  }
}

/// The union of two ascending lists, ascending.
@[ checks ]
def rec union(xs : List(Integer), ys : List(Integer)) -> -F List(Integer) {
  case xs {
    Nil => ys,
    Cons(x, rest) => {
      run joined <- union[<](rest, ys);
      become insert(x, joined)
    }
  }
}

/// Who a dispatch's slot is with: a seat, or nobody once its last holder
/// retired.
@[ checks ]
data Holder : Type {
  SeatHolds : (seat : Integer) --> Holder;
  Vacant : Holder;
}

/// The admitted dispatch last in canonical order in a commit's causal past,
/// with where it was placed, where the slot last moved and who holds it, or
/// none.
@[ checks ]
data Course : Type {
  Idle : Course;
  Dispatched : (placed : Integer, dispatch : Integer, moved : Integer, holder : Holder) --> Course;
}

/// The later of two courses, the order two pasts merge by: a later dispatch
/// supersedes an earlier one, and of one dispatch the slot's later move wins.
@[ checks ]
def later(a : Course, b : Course) -> -F Course {
  case a {
    Idle => b,
    Dispatched(placed, dispatch, moved, holder) => case b {
      Idle => a,
      Dispatched(otherPlaced, otherDispatch, otherMoved, otherHolder) => case placed < otherPlaced {
        true => b,
        false => case placed == otherPlaced {
          true => case moved < otherMoved {
            true => b,
            false => a
          },
          false => a
        }
      }
    }
  }
}

/// This course with its slot moved to `holder` by the commit placed at
/// `place`; no course stays none.
@[ checks ]
def moved(course : Course, place : Integer, holder : Holder) -> -F Course {
  case course {
    Idle => Idle,
    Dispatched(placed, dispatch, before, was) => Dispatched(placed, dispatch, place, holder)
  }
}

/// Whether `author` may report on, hand off, retire from or pause
/// `dispatch` here: the course is of that dispatch and `author` holds its
/// slot.
@[ checks ]
def answerable(course : Course, dispatch : Integer, author : Integer) -> -F Outcome {
  case course {
    Idle => Fail(NotCurrent),
    Dispatched(placed, current, moved, holder) => case current == dispatch {
      true => case holder {
        SeatHolds(seat) => case seat == author {
          true => Pass,
          false => Fail(NotHolder)
        },
        Vacant => Fail(NotHolder)
      },
      false => Fail(NotCurrent)
    }
  }
}

/// Whether `dispatch` is the course's, whoever holds its slot.
@[ checks ]
def current(course : Course, dispatch : Integer) -> -F Outcome {
  case course {
    Idle => Fail(NotCurrent),
    Dispatched(placed, held, moved, holder) => case held == dispatch {
      true => Pass,
      false => Fail(NotCurrent)
    }
  }
}

/// What a commit's causal past, the commit itself included, hands its
/// children: the peers granted, the peers given a slot, the admitted
/// verdicts and decisions, and the course.
@[ checks ]
data Past : Type {
  Past : (
    grantees : List(Integer),
    seats : List(Integer),
    verdicts : List(Integer),
    decisions : List(Integer),
    course : Course
  ) --> Past;
}

/// The past of a commit with no parent placed.
@[ checks ]
def emptyPast = (Past(Nil, Nil, Nil, Nil, Idle) : Past);

/// Two pasts merged: the union of each set, and the later course.
@[ checks ]
def merge(a : Past, b : Past) -> -F Past {
  case a {
    Past(grantees, seats, verdicts, decisions, course) => case b {
      Past(moreGrantees, moreSeats, moreVerdicts, moreDecisions, otherCourse) => {
        run g <- union(grantees, moreGrantees);
        run s <- union(seats, moreSeats);
        run v <- union(verdicts, moreVerdicts);
        run d <- union(decisions, moreDecisions);
        run c <- later(course, otherCourse);
        Past(g, s, v, d, c)
      }
    }
  }
}

/// Where a channel's play stands: a slot before its dispatch, owing its
/// first report, or open to another report or an ending; a judge's channel
/// before its verdict or owing its grading; a runner's, always open; an
/// operator's before its choice or owing the landing a choice to land
/// requires; or ended.
@[ checks ]
data Phase : Type {
  SlotFresh : Phase;
  SlotOwed : Phase;
  SlotOpen : Phase;
  JudgeFresh : Phase;
  JudgeRuled : Phase;
  RunnerOpen : Phase;
  DecisionFresh : Phase;
  DecisionLanding : Phase;
  Ended : Phase;
}

/// A move replayed: the phase it leaves the play in, or why the monitor
/// refuses it, leaving the play where it was.
@[ checks ]
data Replayed : Type {
  Moved : (phase : Phase) --> Replayed;
  Stuck : (reason : Reason) --> Replayed;
}

/// Whether the peer knows an edition's protocols: editions 1 and 2.
@[ checks ]
def known(edition : Integer) -> -F Bool {
  case edition == 1 {
    true => edition == 1,
    false => edition == 2
  }
}

/// A pause under `edition` at `phase`: edition 2 offers it in both slot
/// phases and keeps the phase; edition 1 offers no such label.
@[ checks ]
def paused(edition : Integer, phase : Phase) -> -F Replayed {
  case edition == 2 {
    true => Moved(phase),
    false => Stuck(WrongLabel)
  }
}

/// A move replayed against its channel's play under `edition`. The slot is
/// `?Dispatch . report . μX.(report . X | handoff . end | retire . end)`,
/// edition 2 adding `pause` in both phases; the judge's `!Verdict . !Graded
/// . end`; the runner's `μt. !Verified . t`; the operator's a choice of land
/// (`!Decide . !Landed . end`), rework or abandon (`!Decide . end`). An
/// ended play refuses every move, as resuming after its end; a fresh slot
/// play receives only its dispatch.
@[ checks ]
def replay(edition : Integer, phase : Phase, move : Move) -> -F Replayed {
  case known(edition) {
    false => Stuck(UnknownEdition),
    true => case phase {
      SlotFresh => case move {
        DispatchMove => Moved(SlotOwed),
        _ => Stuck(WrongDirection)
      },
      SlotOwed => case move {
        ReportMove => Moved(SlotOpen),
        PauseMove => become paused(edition, phase),
        _ => Stuck(WrongLabel)
      },
      SlotOpen => case move {
        ReportMove => Moved(SlotOpen),
        HandoffMove => Moved(Ended),
        RetireMove => Moved(Ended),
        PauseMove => become paused(edition, phase),
        _ => Stuck(WrongLabel)
      },
      JudgeFresh => case move {
        VerdictMove => Moved(JudgeRuled),
        _ => Stuck(WrongPayloadIdentity)
      },
      JudgeRuled => case move {
        GradedMove => Moved(Ended),
        _ => Stuck(WrongPayloadIdentity)
      },
      RunnerOpen => Moved(RunnerOpen),
      DecisionFresh => case move {
        DecideMove(choice) => case choice {
          ToLand => Moved(DecisionLanding),
          _ => Moved(Ended)
        },
        _ => Stuck(WrongDirection)
      },
      DecisionLanding => case move {
        LandedMove => Moved(Ended),
        _ => Stuck(WrongDirection)
      },
      Ended => Stuck(ResumeAfterEnd)
    }
  }
}

/// Whether two grades are one.
@[ checks ]
def same(a : Grade, b : Grade) -> -F Bool {
  case a {
    Met => case b {
      Met => 0 == 0,
      _ => 0 == 1
    },
    Unmet => case b {
      Unmet => 0 == 0,
      _ => 0 == 1
    },
    Undecided => case b {
      Undecided => 0 == 0,
      _ => 0 == 1
    },
    Refused => case b {
      Refused => 0 == 0,
      _ => 0 == 1
    }
  }
}

/// Whether the judge read no ruling on a question.
@[ checks ]
def unread(ruled : Ruled) -> -F Bool {
  case ruled {
    OnQuestion(question, ruling) => case ruling {
      Read(probabilities, outside) => 0 == 1,
      Unread(reason) => 0 == 0
    }
  }
}

/// Whether grades answer a verdict's rulings: one grade per ruling, refused
/// exactly where the judge read no ruling.
@[ checks ]
def rec answers(grades : List(Grade), rulings : List(Ruled)) -> -F Bool {
  case grades {
    Nil => case rulings {
      Nil => 0 == 0,
      Cons(ruled, rest) => 0 == 1
    },
    Cons(grade, moreGrades) => case rulings {
      Nil => 0 == 1,
      Cons(ruled, moreRulings) => {
        run refused <- same(grade, Refused);
        run blank <- unread(ruled);
        case refused {
          true => case blank {
            true => become answers[<](moreGrades, moreRulings),
            false => blank
          },
          false => case blank {
            true => refused,
            false => become answers[<](moreGrades, moreRulings)
          }
        }
      }
    }
  }
}

/// A grading of a verdict ruled by `judge` with `rulings`, by `author`: the
/// judge's, answering the rulings, its composition the conjunction of its
/// grades.
@[ checks ]
def grading(
  judge : Integer,
  rulings : List(Ruled),
  author : Integer,
  grades : List(Grade),
  composed : Grade
) -> -F Outcome {
  case author == judge {
    false => Fail(NotJudge),
    true => case answers(grades, rulings) {
      false => Fail(Misgraded),
      true => {
        run conjunction <- compose(grades);
        case same(composed, conjunction) {
          true => Pass,
          false => Fail(Miscomposed)
        }
      }
    }
  }
}

/// A landing of a decision by `operator`, by `author`: the deciding
/// operator's alone.
@[ checks ]
def landing(operator : Integer, author : Integer) -> -F Outcome {
  case author == operator {
    true => Pass,
    false => Fail(NotOperator)
  }
}
