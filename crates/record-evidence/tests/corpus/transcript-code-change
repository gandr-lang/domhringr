+criteria.true = "The issue names the test whose passing closes it."
+criteria.false = "The issue names no test, or closes on a judgement such as works well or reads better."
+
+[questions.evidence]
+instructions = """
+Read the issue. Does it state the current behaviour with evidence a reader \
+can reproduce: the command run and its output, the file and the anchor or \
+commit it is read at, or the steps that reach the state?"""
+criteria.true = "The issue shows what happens now, with evidence a reader can reproduce."
+criteria.false = "The issue asserts a problem or a need without evidence a reader can reproduce."
